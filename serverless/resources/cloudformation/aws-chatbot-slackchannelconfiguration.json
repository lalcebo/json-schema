      "type": "array",
      "insertionOrder": false,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^(^$|arn:aws:iam:[A-Za-z0-9_\\/.-]{0,63}:[A-Za-z0-9_\\/.-]{0,63}:[A-Za-z0-9][A-Za-z0-9:_\\/+=,@.-]{0,1023})$"
