  "definitions": {
    "SelectiveContentGuarding": {
      "type": "object",
      "description": "Selective content guarding controls for enforced guardrails",
      "additionalProperties": false,
      "properties": {
        "System": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "SELECTIVE",
                "COMPREHENSIVE"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Selective guarding mode for system prompts"
        },
        "Messages": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "SELECTIVE",
                "COMPREHENSIVE"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Selective guarding mode for user messages"
        }
      },
      "title": "AWSBedrockEnforcedGuardrailConfigurationSelectiveContentGuardingDefinition"
    },
    "ConfigOwner": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ACCOUNT"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Configuration owner type",
      "title": "AWSBedrockEnforcedGuardrailConfigurationConfigOwnerDefinition"
    },
    "ModelEnforcement": {
      "type": "object",
      "description": "Model-specific information for the enforced guardrail configuration. If not present, the configuration is enforced on all models",
      "properties": {
        "IncludedModels": {
          "type": "array",
          "description": "Models to enforce the guardrail on",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(ALL|([a-z0-9-]{1,63}[.]{1}[a-z0-9-]{1,63})([:][a-z0-9-]{1,63}){0,2}(/[a-z0-9]{12}){0,1})$"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ],
            "description": "Model identifier or ALL"
          }
        },
        "ExcludedModels": {
          "type": "array",
          "description": "Models to exclude from enforcement. If a model is in both lists, it is excluded",
          "minItems": 0,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^([a-z0-9-]{1,63}[.]{1}[a-z0-9-]{1,63})([:][a-z0-9-]{1,63}){0,2}(/[a-z0-9]{12}){0,1}$"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ],
            "description": "Model identifier to exclude"
          }
        }
      },
      "required": [
        "IncludedModels",
        "ExcludedModels"
      ],
      "additionalProperties": false,
      "title": "AWSBedrockEnforcedGuardrailConfigurationModelEnforcementDefinition"
    }
  },
  "properties": {
    "GuardrailIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^(([a-z0-9]+)|(arn:aws(-[^:]+)?:bedrock:[a-z0-9-]{1,20}:[0-9]{12}:guardrail/[a-z0-9]+))$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Identifier for the guardrail, could be the ID or the ARN"
    },
    "GuardrailVersion": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,7}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Numerical guardrail version (not DRAFT)"
    },
    "SelectiveContentGuarding": {
      "$ref": "#/definitions/SelectiveContentGuarding"
    },
    "ModelEnforcement": {
      "$ref": "#/definitions/ModelEnforcement"
