{
  "typeName": "AWS::PCAConnectorSCEP::Connector",
  "description": "Represents a Connector that allows certificate issuance through Simple Certificate Enrollment Protocol (SCEP). Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-pcaconnectorscep",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-pcaconnectorscep",
  "definitions": {
    "ConnectorType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "GENERAL_PURPOSE",
            "INTUNE"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSPCAConnectorSCEPConnectorConnectorTypeDefinition"
    },
    "IntuneConfiguration": {
      "type": "object",
      "properties": {
        "AzureApplicationId": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 100,
              "minLength": 15,
              "pattern": "^[a-zA-Z0-9]{2,15}-[a-zA-Z0-9]{2,15}-[a-zA-Z0-9]{2,15}-[a-zA-Z0-9]{2,15}-[a-zA-Z0-9]{2,15}$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Domain": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "AzureApplicationId",
        "Domain"
      ],
      "additionalProperties": false,
      "title": "AWSPCAConnectorSCEPConnectorIntuneConfigurationDefinition"
    },
    "MobileDeviceManagement": {
      "type": "object",
      "oneOf": [
        {
          "title": "Intune",
          "properties": {
            "Intune": {
              "$ref": "#/definitions/IntuneConfiguration"
            }
          },
          "required": [
            "Intune"
          ],
          "additionalProperties": false
        }
      ],
      "title": "AWSPCAConnectorSCEPConnectorMobileDeviceManagementDefinition"
    },
    "OpenIdConfiguration": {
      "type": "object",
      "properties": {
        "Issuer": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Subject": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Audience": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "AWSPCAConnectorSCEPConnectorOpenIdConfigurationDefinition"
    },
    "Tags": {
      "type": "object",
      "patternProperties": {
        ".+": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "AWSPCAConnectorSCEPConnectorTagsDefinition"
    },
    "Unit": {
      "type": "object",
      "additionalProperties": false,
      "title": "AWSPCAConnectorSCEPConnectorUnitDefinition"
    }
  },
  "properties": {
    "CertificateAuthorityArn": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200,
          "minLength": 5,
          "pattern": "^arn:aws(-[a-z]+)*:acm-pca:[a-z]+(-[a-z]+)+-[1-9]\\d*:\\d{12}:certificate-authority\\/[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "MobileDeviceManagement": {
      "$ref": "#/definitions/MobileDeviceManagement"
    },
    "Tags": {
      "$ref": "#/definitions/Tags"
    },
    "VpcEndpointId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200,
          "minLength": 5
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    }
  },
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "pca-connector-scep:ListTagsForResource",
      "pca-connector-scep:TagResource",
      "pca-connector-scep:UntagResource"
    ]
  },
  "required": [
    "CertificateAuthorityArn"
  ],
  "readOnlyProperties": [
    "/properties/ConnectorArn",
    "/properties/Endpoint",
    "/properties/OpenIdConfiguration",
    "/properties/Type"
  ],
  "createOnlyProperties": [
    "/properties/CertificateAuthorityArn",
    "/properties/MobileDeviceManagement",
    "/properties/VpcEndpointId"
  ],
  "writeOnlyProperties": [
    "/properties/VpcEndpointId"
  ],
  "primaryIdentifier": [
    "/properties/ConnectorArn"
  ],
  "additionalProperties": false,
  "type": "object",
  "title": "AWSPCAConnectorSCEPConnectorProperties"
}