{
  "typeName": "AWS::DataZone::Environment",
  "description": "Definition of AWS::DataZone::Environment Resource Type. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-datazone",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-datazone",
  "definitions": {
    "EnvironmentParameter": {
      "type": "object",
      "description": "The parameter details of an environment.",
      "properties": {
        "Name": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The name of an environment parameter."
        },
        "Value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value of an environment parameter."
        }
      },
      "additionalProperties": false,
      "title": "AWSDataZoneEnvironmentEnvironmentParameterDefinition"
    },
    "EnvironmentStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ACTIVE",
            "CREATING",
            "UPDATING",
            "DELETING",
            "CREATE_FAILED",
            "UPDATE_FAILED",
            "DELETE_FAILED",
            "VALIDATION_FAILED",
            "SUSPENDED",
            "DISABLED",
            "EXPIRED",
            "DELETED",
            "INACCESSIBLE"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The status of the Amazon DataZone environment.",
      "title": "AWSDataZoneEnvironmentEnvironmentStatusDefinition"
    }
  },
  "properties": {
    "EnvironmentAccountIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{12}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The AWS account in which the Amazon DataZone environment is created."
    },
    "EnvironmentAccountRegion": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z]{4,10}-\\d$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The AWS region in which the Amazon DataZone environment is created."
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The description of the Amazon DataZone environment."
    },
    "DomainIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^dzd[-_][a-zA-Z0-9_-]{1,36}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The identifier of the Amazon DataZone domain in which the environment would be created."
    },
    "EnvironmentBlueprintIdentifier": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The identifier of the environment blueprint."
    },
    "DeploymentOrder": {
      "type": "integer",
      "description": "The deployment order for the environment."
    },
    "EnvironmentConfigurationId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The identifier of the environment configuration."
    },
    "EnvironmentProfileIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{0,36}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ID of the environment profile with which the Amazon DataZone environment would be created."
    },
    "GlossaryTerms": {
      "type": "array",
      "insertionOrder": false,
      "description": "The glossary terms that can be used in the Amazon DataZone environment.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,36}$"
          },
          {
            "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
          }
        ]
      },
      "maxItems": 20,
      "minItems": 0
    },
    "EnvironmentRoleArn": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Environment role arn for custom aws environment permissions"
    },
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the environment."
    },
    "ProjectIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ID of the Amazon DataZone project in which the environment would be created."
    },
    "UserParameters": {
      "type": "array",
      "insertionOrder": false,
      "description": "The user parameters of the Amazon DataZone environment.",
      "items": {
        "$ref": "#/definitions/EnvironmentParameter"
      }
    }
  },
  "required": [
    "Name",
    "ProjectIdentifier",
    "DomainIdentifier"
  ],
  "readOnlyProperties": [
    "/properties/AwsAccountId",
    "/properties/AwsAccountRegion",
    "/properties/CreatedAt",
    "/properties/CreatedBy",
    "/properties/DomainId",
    "/properties/EnvironmentBlueprintId",
    "/properties/EnvironmentProfileId",
    "/properties/Id",
    "/properties/ProjectId",
    "/properties/Provider",
    "/properties/Status",
    "/properties/UpdatedAt"
  ],
  "writeOnlyProperties": [
    "/properties/EnvironmentProfileIdentifier",
    "/properties/ProjectIdentifier",
    "/properties/DomainIdentifier",
    "/properties/EnvironmentAccountIdentifier",
    "/properties/EnvironmentAccountRegion",
    "/properties/EnvironmentRoleArn",
    "/properties/EnvironmentBlueprintIdentifier",
    "/properties/DeploymentOrder",
    "/properties/EnvironmentConfigurationId"
  ],
  "createOnlyProperties": [
    "/properties/DomainIdentifier",
    "/properties/EnvironmentProfileIdentifier",
    "/properties/ProjectIdentifier",
    "/properties/UserParameters",
    "/properties/EnvironmentAccountIdentifier",
    "/properties/EnvironmentAccountRegion",
    "/properties/EnvironmentBlueprintIdentifier",
    "/properties/DeploymentOrder",
    "/properties/EnvironmentConfigurationId"
  ],
  "primaryIdentifier": [
    "/properties/DomainId",
    "/properties/Id"
  ],
  "additionalIdentifiers": [
    [
      "/properties/DomainIdentifier"
    ]
  ],
  "tagging": {
    "taggable": false
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSDataZoneEnvironmentProperties"
}