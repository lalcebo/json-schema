  "required": [
    "CacheNodeType",
    "NumCacheNodes",
    "Engine"
  ],
  "createOnlyProperties": [
    "/properties/Port",
    "/properties/SnapshotArns",
    "/properties/SnapshotName",
    "/properties/CacheSubnetGroupName",
    "/properties/ClusterName",
    "/properties/Engine",
    "/properties/NetworkType"
  ],
  "writeOnlyProperties": [
    "/properties/SnapshotArns",
    "/properties/SnapshotName",
    "/properties/CacheSecurityGroupNames",
    "/properties/PreferredAvailabilityZone"
  ],
  "conditionalCreateOnlyProperties": [
    "/properties/PreferredAvailabilityZones",
    "/properties/IpDiscovery"
  ],
  "primaryIdentifier": [
