  ],
  "readOnlyProperties": [
    "/properties/ConfigurationEndpoint",
    "/properties/ConfigurationEndpoint/Port",
    "/properties/ConfigurationEndpoint/Address",
    "/properties/RedisEndpoint",
    "/properties/RedisEndpoint/Port",
    "/properties/RedisEndpoint/Address"
  ],
  "deprecatedProperties": [
    "/properties/CacheSecurityGroupNames"
  ],
  "propertyTransform": {
    "/properties/EngineVersion": "$join($split(EngineVersion, \".\", 2), \".\")"
  },
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "elasticache:AddTagsToResource",
      "elasticache:RemoveTagsFromResource",
      "elasticache:ListTagsForResource"
    ]
  },
  "type": "object",
  "title": "AWSElastiCacheCacheClusterProperties"
}