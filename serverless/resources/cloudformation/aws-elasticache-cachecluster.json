        "Port": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "title": "AWSElastiCacheCacheClusterEndpointDefinition"
    },
    "LogDeliveryConfigurationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LogType": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Valid value is either slow-log, which refers to slow-log or engine-log"
        },
        "LogFormat": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Valid values are either json or text"
        },
        "DestinationType": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Specify either CloudWatch Logs or Kinesis Data Firehose as the destination type. "
        },
        "DestinationDetails": {
          "description": "Configuration details of either a CloudWatch Logs destination or Kinesis Data Firehose destination.",
          "$ref": "#/definitions/DestinationDetails"
        }
      },
      "required": [
        "LogFormat",
        "LogType",
        "DestinationType",
        "DestinationDetails"
      ],
      "title": "AWSElastiCacheCacheClusterLogDeliveryConfigurationRequestDefinition"
    },
    "KinesisFirehoseDestinationDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "DeliveryStream": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The name of the Kinesis Data Firehose delivery stream"
        }
      },
      "required": [
        "DeliveryStream"
      ],
      "title": "AWSElastiCacheCacheClusterKinesisFirehoseDestinationDetailsDefinition"
    },
    "CloudWatchLogsDestinationDetails": {
      "type": "object",
      "additionalProperties": false,
