        "LogGroup": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The name of the CloudWatch Logs log group."
        }
      },
      "required": [
        "LogGroup"
      ],
      "title": "AWSElastiCacheCacheClusterCloudWatchLogsDestinationDetailsDefinition"
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Key": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Value",
        "Key"
      ],
      "title": "AWSElastiCacheCacheClusterTagDefinition"
    },
    "DestinationDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CloudWatchLogsDetails": {
          "description": "The configuration details of the CloudWatch Logs destination",
          "$ref": "#/definitions/CloudWatchLogsDestinationDetails"
        },
        "KinesisFirehoseDetails": {
          "description": "The configuration details of the Kinesis Data Firehose destination.",
          "$ref": "#/definitions/KinesisFirehoseDestinationDetails"
        }
      },
      "title": "AWSElastiCacheCacheClusterDestinationDetailsDefinition"
    }
