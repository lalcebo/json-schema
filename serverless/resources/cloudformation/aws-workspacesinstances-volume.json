  "properties": {
    "AvailabilityZone": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z]+-\\d[a-z](-[a-z0-9]+)?$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Availability Zone in which to create the volume"
