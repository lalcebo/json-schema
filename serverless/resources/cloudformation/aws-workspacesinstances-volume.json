          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The key name of the tag"
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the tag"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false,
      "title": "AWSWorkspacesInstancesVolumeTagDefinition"
    },
    "TagSpecification": {
      "type": "object",
      "properties": {
        "ResourceType": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "instance",
                "volume",
                "spot-instances-request",
                "network-interface"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Tags": {
          "type": "array",
