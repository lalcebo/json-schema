{
  "typeName": "AWS::AppIntegrations::Application",
  "description": "Resource Type definition for AWS:AppIntegrations::Application. Source:- https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "definitions": {
    "Tag": {
      "description": "A label for tagging Application resources",
      "type": "object",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?!aws:)[a-zA-Z+-=._:/]+$",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A key to identify the tag."
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Corresponding tag value for the key."
        }
      },
      "additionalProperties": false,
      "required": [
        "Key",
        "Value"
      ],
      "title": "AWSAppIntegrationsApplicationTagDefinition"
    },
    "ExternalUrlConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AccessUrl"
      ],
      "properties": {
        "AccessUrl": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\w+\\:\\/\\/.*$",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "ApprovedOrigins": {
          "type": "array",
          "insertionOrder": false,
          "items": {
            "$ref": "#/definitions/ApprovedOrigins"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "title": "AWSAppIntegrationsApplicationExternalUrlConfigDefinition"
    },
    "ApprovedOrigins": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\w+\\:\\/\\/.*$",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSAppIntegrationsApplicationApprovedOriginsDefinition"
    },
    "Permissions": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9\\/\\._\\-\\*]+$",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSAppIntegrationsApplicationPermissionsDefinition"
    },
    "ContactHandling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Scope": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "CROSS_CONTACTS",
                "PER_CONTACT"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Scope"
      ],
      "title": "AWSAppIntegrationsApplicationContactHandlingDefinition"
    },
    "ApplicationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ContactHandling": {
          "$ref": "#/definitions/ContactHandling"
        }
      },
      "title": "AWSAppIntegrationsApplicationApplicationConfigDefinition"
    },
    "IframeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Allow": {
          "type": "array",
          "insertionOrder": false,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          }
        },
        "Sandbox": {
          "type": "array",
          "insertionOrder": false,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          }
        }
      },
      "title": "AWSAppIntegrationsApplicationIframeConfigDefinition"
    }
  },
  "properties": {
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9\\/\\._ \\-]+$",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the application."
    },
    "Namespace": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9/\\._\\-]+$",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The namespace of the application."
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The application description."
    },
    "ApplicationSourceConfig": {
      "description": "Application source config",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ExternalUrlConfig": {
          "$ref": "#/definitions/ExternalUrlConfig"
        }
      },
      "required": [
        "ExternalUrlConfig"
      ]
    },
    "Permissions": {
      "description": "The configuration of events or requests that the application has access to.",
      "type": "array",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Permissions"
      },
      "minItems": 0,
      "maxItems": 150
    },
    "Tags": {
      "description": "The tags (keys and values) associated with the application.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "IsService": {
      "description": "Indicates if the application is a service",
      "type": "boolean",
      "default": false
    },
    "ApplicationType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "STANDARD",
            "SERVICE",
            "MCP_SERVER"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The type of application"
    },
    "InitializationTimeout": {
      "description": "The initialization timeout in milliseconds. Required when IsService is true.",
      "type": "integer"
    },
    "ApplicationConfig": {
      "description": "The application configuration. Cannot be used when IsService is true.",
      "$ref": "#/definitions/ApplicationConfig"
    },
    "IframeConfig": {
      "description": "The iframe configuration",
      "$ref": "#/definitions/IframeConfig"
    }
  },
  "additionalProperties": false,
  "required": [
    "Name",
    "Namespace",
    "ApplicationSourceConfig"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "app-integrations:TagResource",
      "app-integrations:UntagResource"
    ]
  },
  "readOnlyProperties": [
    "/properties/ApplicationArn",
    "/properties/Id"
  ],
  "primaryIdentifier": [
    "/properties/ApplicationArn"
  ],
  "type": "object",
  "title": "AWSAppIntegrationsApplicationProperties"
}