{
  "typeName": "AWS::Connect::Queue",
  "description": "Resource Type definition for AWS::Connect::Queue. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-connect",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-connect",
  "definitions": {
    "OutboundCallerIdName": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The caller ID name.",
      "title": "AWSConnectQueueOutboundCallerIdNameDefinition"
    },
    "OutboundCallerIdNumberArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:phone-number/[-a-zA-Z0-9]*$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The caller ID number.",
      "title": "AWSConnectQueueOutboundCallerIdNumberArnDefinition"
    },
    "OutboundFlowArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-zA-Z0-9]*/contact-flow/[-a-zA-Z0-9]*$",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The outbound whisper flow to be used during an outbound call.",
      "title": "AWSConnectQueueOutboundFlowArnDefinition"
    },
    "OutboundEmailAddressId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-zA-Z0-9]*/email-address/[-a-zA-Z0-9]*$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The email address connect resource ID.",
      "title": "AWSConnectQueueOutboundEmailAddressIdDefinition"
    },
    "Tag": {
      "description": "A key-value pair to associate with a resource.",
      "type": "object",
      "properties": {
        "Key": {
          "$ref": "#/definitions/Key"
        },
        "Value": {
          "$ref": "#/definitions/Value"
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false,
      "title": "AWSConnectQueueTagDefinition"
    },
    "Key": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!aws:)[a-zA-Z+-=._:/]+$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The key name of the tag. You can specify a value that is 1 to 128 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -.",
      "title": "AWSConnectQueueKeyDefinition"
    },
    "Value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The value for the tag. You can specify a value that is 0 to 256 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -.",
      "title": "AWSConnectQueueValueDefinition"
    },
    "OutboundCallerConfig": {
      "description": "The outbound caller ID name, number, and outbound whisper flow.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "OutboundCallerIdName": {
          "$ref": "#/definitions/OutboundCallerIdName"
        },
        "OutboundCallerIdNumberArn": {
          "$ref": "#/definitions/OutboundCallerIdNumberArn"
        },
        "OutboundFlowArn": {
          "$ref": "#/definitions/OutboundFlowArn"
        }
      },
      "title": "AWSConnectQueueOutboundCallerConfigDefinition"
    },
    "OutboundEmailConfig": {
      "description": "The outbound email address ID.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "OutboundEmailAddressId": {
          "$ref": "#/definitions/OutboundEmailAddressId"
        }
      },
      "title": "AWSConnectQueueOutboundEmailConfigDefinition"
    },
    "QuickConnectArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-zA-Z0-9]*/transfer-destination/[-a-zA-Z0-9]*$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Amazon Resource Name (ARN) for the quick connect.",
      "title": "AWSConnectQueueQuickConnectArnDefinition"
    },
    "EmailAddress": {
      "description": "An email address configuration for the queue",
      "type": "object",
      "properties": {
        "EmailAddressArn": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-f0-9]{8}-[-a-f0-9]{4}-[-a-f0-9]{4}-[-a-f0-9]{4}-[-a-f0-9]{12}/email-address/[-a-f0-9]{8}-[-a-f0-9]{4}-[-a-f0-9]{4}-[-a-f0-9]{4}-[-a-f0-9]{12}$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The Amazon Resource Name (ARN) of the email address"
        }
      },
      "required": [
        "EmailAddressArn"
      ],
      "additionalProperties": false,
      "title": "AWSConnectQueueEmailAddressDefinition"
    }
  },
  "properties": {
    "InstanceArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-zA-Z0-9]*$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The identifier of the Amazon Connect instance."
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The description of the queue."
    },
    "HoursOfOperationArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-zA-Z0-9]*/operating-hours/[-a-zA-Z0-9]*$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The identifier for the hours of operation."
    },
    "MaxContacts": {
      "description": "The maximum number of contacts that can be in the queue before it is considered full.",
      "type": "integer",
      "minimum": 0
    },
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the queue."
    },
    "OutboundCallerConfig": {
      "description": "The outbound caller ID name, number, and outbound whisper flow.",
      "$ref": "#/definitions/OutboundCallerConfig"
    },
    "OutboundEmailConfig": {
      "description": "The outbound email address ID.",
      "$ref": "#/definitions/OutboundEmailConfig"
    },
    "Status": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ENABLED",
            "DISABLED"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The status of the queue."
    },
    "QuickConnectArns": {
      "description": "The quick connects available to agents who are working the queue.",
      "type": "array",
      "minItems": 1,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/QuickConnectArn"
      }
    },
    "Tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "insertionOrder": false,
      "description": "An array of key-value pairs to apply to this resource.",
      "items": {
        "$ref": "#/definitions/Tag"
      }
    },
    "AdditionalEmailAddresses": {
      "description": "The email addresses that agents can use when replying to or initiating email contacts",
      "type": "array",
      "items": {
        "$ref": "#/definitions/EmailAddress"
      },
      "minItems": 0,
      "maxItems": 50,
      "insertionOrder": false
    }
  },
  "additionalProperties": false,
  "primaryIdentifier": [
    "/properties/QueueArn"
  ],
  "readOnlyProperties": [
    "/properties/QueueArn",
    "/properties/Type"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "connect:TagResource",
      "connect:UntagResource"
    ]
  },
  "required": [
    "InstanceArn",
    "HoursOfOperationArn",
    "Name"
  ],
  "type": "object",
  "title": "AWSConnectQueueProperties"
}