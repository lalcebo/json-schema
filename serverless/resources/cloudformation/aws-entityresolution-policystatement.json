{
  "typeName": "AWS::EntityResolution::PolicyStatement",
  "description": "Policy Statement defined in AWS Entity Resolution Service. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-entity-resolution.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-entity-resolution.git",
  "definitions": {
    "VeniceGlobalArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:(aws|aws-us-gov|aws-cn):entityresolution:[a-z]{2}-[a-z]{1,10}-[0-9]:[0-9]{12}:((schemamapping|matchingworkflow|idmappingworkflow|idnamespace)/[a-zA-Z_0-9-]{1,255})$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Arn of the resource to which the policy statement is being attached.",
      "title": "AWSEntityResolutionPolicyStatementVeniceGlobalArnDefinition"
    },
    "StatementId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-Za-z]+$",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Statement Id of the policy statement that is being attached.",
      "title": "AWSEntityResolutionPolicyStatementStatementIdDefinition"
    },
    "StatementEffect": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Allow",
            "Deny"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionPolicyStatementStatementEffectDefinition"
    },
    "StatementAction": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(entityresolution:[a-zA-Z0-9]+)$",
          "minLength": 3,
          "maxLength": 64
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionPolicyStatementStatementActionDefinition"
    },
    "StatementActionList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StatementAction"
      },
      "title": "AWSEntityResolutionPolicyStatementStatementActionListDefinition"
    },
    "StatementPrincipal": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(\\\\d{12})|([a-z0-9\\\\.]+)$",
          "minLength": 12,
          "maxLength": 64
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionPolicyStatementStatementPrincipalDefinition"
    },
    "StatementPrincipalList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StatementPrincipal"
      },
      "title": "AWSEntityResolutionPolicyStatementStatementPrincipalListDefinition"
    },
    "StatementCondition": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40960
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionPolicyStatementStatementConditionDefinition"
    }
  },
  "properties": {
    "Arn": {
      "$ref": "#/definitions/VeniceGlobalArn"
    },
    "StatementId": {
      "$ref": "#/definitions/StatementId"
    },
    "Effect": {
      "$ref": "#/definitions/StatementEffect"
    },
    "Action": {
      "$ref": "#/definitions/StatementActionList"
    },
    "Principal": {
      "$ref": "#/definitions/StatementPrincipalList"
    },
    "Condition": {
      "$ref": "#/definitions/StatementCondition"
    }
  },
  "additionalProperties": false,
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false,
    "cloudFormationSystemTags": false
  },
  "required": [
    "Arn",
    "StatementId"
  ],
  "createOnlyProperties": [
    "/properties/StatementId",
    "/properties/Arn"
  ],
  "primaryIdentifier": [
    "/properties/Arn",
    "/properties/StatementId"
  ],
  "type": "object",
  "title": "AWSEntityResolutionPolicyStatementProperties"
}