    "AutoAccept": {
      "description": "The Auto accept setting.",
      "type": "boolean",
      "title": "AWSConnectUserAutoAcceptDefinition"
    },
    "DeskPhoneNumber": {
      "oneOf": [
        {
          "type": "string"
