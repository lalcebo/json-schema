{
  "typeName": "AWS::Deadline::Limit",
  "description": "Resource Type definition for AWS::Deadline::Limit. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-deadline",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-deadline",
  "properties": {
    "AmountRequirementName": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "default": "",
          "maxLength": 100,
          "minLength": 0
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "DisplayName": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "FarmId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^farm-[0-9a-f]{32}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "MaxCount": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": -1
    }
  },
  "required": [
    "AmountRequirementName",
    "DisplayName",
    "MaxCount",
    "FarmId"
  ],
  "readOnlyProperties": [
    "/properties/CurrentCount",
    "/properties/LimitId"
  ],
  "createOnlyProperties": [
    "/properties/AmountRequirementName",
    "/properties/FarmId"
  ],
  "primaryIdentifier": [
    "/properties/FarmId",
    "/properties/LimitId"
  ],
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false,
    "cloudFormationSystemTags": false
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSDeadlineLimitProperties"
}