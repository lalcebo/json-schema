{
  "typeName": "AWS::PCS::Cluster",
  "description": "AWS::PCS::Cluster resource creates an AWS PCS cluster.. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-pcs.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-pcs.git",
  "definitions": {
    "Accounting": {
      "type": "object",
      "description": "The accounting configuration includes configurable settings for Slurm accounting.",
      "properties": {
        "DefaultPurgeTimeInDays": {
          "type": "integer",
          "description": "The default value for all purge settings for `slurmdbd.conf`. For more information, see the [slurmdbd.conf documentation at SchedMD](https://slurm.schedmd.com/slurmdbd.conf.html). The default value is `-1`. A value of `-1` means there is no purge time and records persist as long as the cluster exists.",
          "default": -1,
          "minimum": -1,
          "maximum": 10000
        },
        "Mode": {
          "oneOf": [
            {
              "type": "string",
              "default": "NONE",
              "enum": [
                "STANDARD",
                "NONE"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The default value is `NONE`. A value of `STANDARD` means that Slurm accounting is enabled."
        }
      },
      "required": [
        "Mode"
      ],
      "title": "AWSPCSClusterAccountingDefinition"
    },
    "SlurmRest": {
      "type": "object",
      "description": "The SlurmRest configuration includes configurable settings for Slurm Rest.",
      "properties": {
        "Mode": {
          "oneOf": [
            {
              "type": "string",
              "default": "NONE",
              "enum": [
                "STANDARD",
                "NONE"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The default value is `NONE`. A value of `STANDARD` means that Slurm Rest is enabled."
        }
      },
      "required": [
        "Mode"
      ],
      "additionalProperties": false,
      "title": "AWSPCSClusterSlurmRestDefinition"
    },
    "AuthKey": {
      "type": "object",
      "description": "The shared Slurm key for authentication, also known as the cluster secret.",
      "properties": {
        "SecretArn": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The Amazon Resource Name (ARN) of the the shared Slurm key."
        },
        "SecretVersion": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The version of the shared Slurm key."
        }
      },
      "required": [
        "SecretArn",
        "SecretVersion"
      ],
      "additionalProperties": false,
      "title": "AWSPCSClusterAuthKeyDefinition"
    },
    "JwtAuth": {
      "type": "object",
      "description": "JWT authentication configuration for Slurm.",
      "properties": {
        "JwtKey": {
          "$ref": "#/definitions/JwtKey"
        }
      },
      "additionalProperties": false,
      "title": "AWSPCSClusterJwtAuthDefinition"
    },
    "JwtKey": {
      "type": "object",
      "description": "JWT key configuration.",
      "properties": {
        "SecretArn": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The Amazon Resource Name (ARN) of the JWT key secret."
        },
        "SecretVersion": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The version of the JWT key secret."
        }
      },
      "required": [
        "SecretArn",
        "SecretVersion"
      ],
      "additionalProperties": false,
      "title": "AWSPCSClusterJwtKeyDefinition"
    },
    "Endpoint": {
      "type": "object",
      "description": "An endpoint available for interaction with the scheduler.",
      "properties": {
        "Port": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The endpoint's connection port number."
        },
        "PrivateIpAddress": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The endpoint's private IP address."
        },
        "Ipv6Address": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The endpoint's IPv6 address."
        },
        "Type": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "SLURMCTLD",
                "SLURMDBD",
                "SLURMRESTD"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Indicates the type of endpoint running at the specific IP address."
        },
        "PublicIpAddress": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The endpoint's public IP address."
        }
      },
      "required": [
        "Port",
        "PrivateIpAddress",
        "Type"
      ],
      "additionalProperties": false,
      "title": "AWSPCSClusterEndpointDefinition"
    },
    "ErrorInfo": {
      "type": "object",
      "description": "An error that occurred during resource provisioning.",
      "properties": {
        "Code": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The short-form error code."
        },
        "Message": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The detailed error information."
        }
      },
      "additionalProperties": false,
      "title": "AWSPCSClusterErrorInfoDefinition"
    },
    "SecurityGroupId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "A VPC security group ID.",
      "title": "AWSPCSClusterSecurityGroupIdDefinition"
    },
    "CgroupCustomSetting": {
      "type": "object",
      "description": "Additional cgroup configuration settings.",
      "properties": {
        "ParameterName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The cgroup.conf parameter name."
        },
        "ParameterValue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the cgroup.conf parameter."
        }
      },
      "additionalProperties": false,
      "required": [
        "ParameterName",
        "ParameterValue"
      ],
      "title": "AWSPCSClusterCgroupCustomSettingDefinition"
    },
    "SlurmdbdCustomSetting": {
      "type": "object",
      "description": "Additional slurmdbd configuration settings.",
      "properties": {
        "ParameterName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The slurmdbd.conf parameter name."
        },
        "ParameterValue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the slurmdbd.conf parameter."
        }
      },
      "additionalProperties": false,
      "required": [
        "ParameterName",
        "ParameterValue"
      ],
      "title": "AWSPCSClusterSlurmdbdCustomSettingDefinition"
    },
    "SlurmCustomSetting": {
      "type": "object",
      "description": "Additional settings that directly map to Slurm settings.",
      "properties": {
        "ParameterName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "AWS PCS supports configuration of the following Slurm parameters for clusters: Prolog, Epilog, and SelectTypeParameters."
        },
        "ParameterValue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the configured Slurm setting."
        }
      },
      "additionalProperties": false,
      "required": [
        "ParameterName",
        "ParameterValue"
      ],
      "title": "AWSPCSClusterSlurmCustomSettingDefinition"
    },
    "SubnetId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "A VPC subnet ID.",
      "title": "AWSPCSClusterSubnetIdDefinition"
    },
    "Tag": {
      "type": "object",
      "description": "A key-value pair to associate with a resource.",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The key name of the tag. You can specify a value that is 1 to 128 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -. "
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the tag. You can specify a value that is 0 to 256 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -. "
        }
      },
      "additionalProperties": false,
      "required": [
        "Key"
      ],
      "title": "AWSPCSClusterTagDefinition"
    }
  },
  "properties": {
    "Name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name that identifies the cluster."
    },
    "Networking": {
      "type": "object",
      "description": "The networking configuration for the cluster's control plane.",
      "properties": {
        "SecurityGroupIds": {
          "type": "array",
          "description": "The list of security group IDs associated with the Elastic Network Interface (ENI) created in subnets.",
          "insertionOrder": false,
          "items": {
            "$ref": "#/definitions/SecurityGroupId"
          }
        },
        "SubnetIds": {
          "type": "array",
          "description": "The list of subnet IDs where AWS PCS creates an Elastic Network Interface (ENI) to enable communication between managed controllers and AWS PCS resources. The subnet must have an available IP address, cannot reside in AWS Outposts, AWS Wavelength, or an AWS Local Zone. AWS PCS currently supports only 1 subnet in this list.",
          "insertionOrder": false,
          "items": {
            "$ref": "#/definitions/SubnetId"
          }
        },
        "NetworkType": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "IPV4",
                "IPV6"
              ],
              "insertionOrder": false
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The IP of the cluster (IPV4 or IPV6)"
        }
      },
      "additionalProperties": false
    },
    "Scheduler": {
      "type": "object",
      "description": "The cluster management and job scheduling software associated with the cluster.",
      "properties": {
        "Type": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "SLURM"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The software AWS PCS uses to manage cluster scaling and job scheduling."
        },
        "Version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The version of the specified scheduling software that AWS PCS uses to manage cluster scaling and job scheduling."
        }
      },
      "required": [
        "Type",
        "Version"
      ],
      "additionalProperties": false
    },
    "Size": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "SMALL",
            "MEDIUM",
            "LARGE"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The size of the cluster."
    },
    "SlurmConfiguration": {
      "type": "object",
      "description": "Additional options related to the Slurm scheduler.",
      "properties": {
        "Accounting": {
          "$ref": "#/definitions/Accounting"
        },
        "SlurmRest": {
          "$ref": "#/definitions/SlurmRest"
        },
        "AuthKey": {
          "$ref": "#/definitions/AuthKey"
        },
        "JwtAuth": {
          "$ref": "#/definitions/JwtAuth"
        },
        "ScaleDownIdleTimeInSeconds": {
          "type": "integer",
          "description": "The time before an idle node is scaled down.",
          "minimum": 1
        },
        "SlurmCustomSettings": {
          "type": "array",
          "description": "Additional Slurm-specific configuration that directly maps to Slurm settings.",
          "insertionOrder": false,
          "items": {
            "$ref": "#/definitions/SlurmCustomSetting"
          }
        },
        "CgroupCustomSettings": {
          "type": "array",
          "description": "Additional cgroup-specific configuration that directly maps to cgroup.conf settings.",
          "insertionOrder": false,
          "items": {
            "$ref": "#/definitions/CgroupCustomSetting"
          }
        },
        "SlurmdbdCustomSettings": {
          "type": "array",
          "description": "Additional slurmdbd-specific configuration that directly maps to slurmdbd.conf settings.",
          "insertionOrder": false,
          "items": {
            "$ref": "#/definitions/SlurmdbdCustomSetting"
          }
        }
      },
      "additionalProperties": false
    },
    "Tags": {
      "description": "1 or more tags added to the resource. Each tag consists of a tag key and tag value. The tag value is optional and can be an empty string.",
      "patternProperties": {
        "^.+$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "Networking",
    "Scheduler",
    "Size"
  ],
  "additionalProperties": false,
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "createOnlyProperties": [
    "/properties/Name",
    "/properties/Networking",
    "/properties/Scheduler",
    "/properties/Size"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/Endpoints",
    "/properties/ErrorInfo",
    "/properties/Id",
    "/properties/Status"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "pcs:TagResource",
      "pcs:ListTagsForResource",
      "pcs:UntagResource"
    ]
  },
  "type": "object",
  "title": "AWSPCSClusterProperties"
}