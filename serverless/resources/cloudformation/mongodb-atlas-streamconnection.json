{
  "typeName": "MongoDB::Atlas::StreamConnection",
  "additionalProperties": false,
  "description": "Returns, adds, edits, and removes one connection for a stream workspace in the specified project. To use this resource, the requesting API Key must have the Project Owner roles.. Source:- https://github.com/mongodb/mongodbatlas-cloudformation-resources",
  "sourceUrl": "https://github.com/mongodb/mongodbatlas-cloudformation-resources",
  "documentationUrl": "https://github.com/mongodb/mongodbatlas-cloudformation-resources/blob/master/cfn-resources/stream-connection/README.md",
  "definitions": {
    "DBRoleToExecute": {
      "type": "object",
      "description": "The name of a Built in or Custom DB Role to connect to an Atlas Cluster.",
      "properties": {
        "Role": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The name of the role to use. Can be a built in role or a custom role."
        },
        "Type": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "BUILT_IN",
                "CUSTOM"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Type of the DB role. Can be either BuiltIn or Custom."
        }
      },
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionDBRoleToExecuteDefinition"
    },
    "StreamsKafkaAuthentication": {
      "type": "object",
      "description": "User credentials required to connect to a Kafka Cluster. Includes the authentication type, as well as the parameters for that authentication mode.",
      "properties": {
        "Mechanism": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Style of authentication. Can be one of PLAIN, SCRAM-256, SCRAM-512, or OAUTHBEARER."
        },
        "Method": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "OAuth authentication method."
        },
        "Username": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Username of the account to connect to the Kafka cluster."
        },
        "Password": {
          "oneOf": [
            {
              "type": "string",
              "format": "password"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Password of the account to connect to the Kafka cluster. Review [AWS security best practices for CloudFormation](https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/security-best-practices.html#creds) to manage credentials."
        },
        "TokenEndpointUrl": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "OAuth token endpoint URL."
        },
        "ClientId": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "OAuth client ID."
        },
        "ClientSecret": {
          "oneOf": [
            {
              "type": "string",
              "format": "password"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "OAuth client secret. Review [AWS security best practices for CloudFormation](https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/security-best-practices.html#creds) to manage credentials."
        },
        "Scope": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "OAuth scope."
        },
        "SaslOauthbearerExtensions": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "SASL OAuth bearer extensions."
        },
        "SslCertificate": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "SSL certificate for client authentication to Kafka."
        },
        "SslKey": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "SSL key for client authentication to Kafka. Review [AWS security best practices for CloudFormation](https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/security-best-practices.html#creds) to manage credentials."
        },
        "SslKeyPassword": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Password for the SSL key, if it is password protected. Review [AWS security best practices for CloudFormation](https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/security-best-practices.html#creds) to manage credentials."
        }
      },
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionStreamsKafkaAuthenticationDefinition"
    },
    "StreamsKafkaSecurity": {
      "type": "object",
      "description": "Properties for the secure transport connection to Kafka. For SSL, this can include the trusted certificate to use.",
      "properties": {
        "BrokerPublicCertificate": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A trusted, public x509 certificate for connecting to Kafka over SSL."
        },
        "Protocol": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Describes the transport type. Can be either PLAINTEXT or SSL."
        }
      },
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionStreamsKafkaSecurityDefinition"
    },
    "Config": {
      "type": "object",
      "description": "A map of Kafka key-value pairs for optional configuration. This is a flat object, and keys can have '.' characters.",
      "patternProperties": {
        "^[A-Za-z0-9.]+$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionConfigDefinition"
    },
    "Networking": {
      "type": "object",
      "description": "Networking configuration for connections.",
      "properties": {
        "Access": {
          "type": "object",
          "description": "Network access configuration.",
          "properties": {
            "Type": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ],
              "description": "Type of network access. Can be PUBLIC, VPC, PRIVATE_LINK, or TRANSIT_GATEWAY."
            },
            "ConnectionId": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ],
              "description": "Unique identifier of the connection."
            },
            "Name": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ],
              "description": "Reserved. Will be used by PRIVATE_LINK connection type."
            },
            "TgwRouteId": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ],
              "description": "Reserved. Will be used by TRANSIT_GATEWAY connection type."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "Access"
      ],
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionNetworkingDefinition"
    },
    "Aws": {
      "type": "object",
      "description": "AWS Lambda connection configuration.",
      "properties": {
        "RoleArn": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Amazon Resource Name (ARN) of the IAM role for AWS Lambda connection."
        },
        "TestBucket": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The name of an S3 bucket used to check authorization of the passed-in IAM role ARN."
        }
      },
      "required": [
        "RoleArn"
      ],
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionAwsDefinition"
    },
    "SchemaRegistryAuthentication": {
      "type": "object",
      "description": "Authentication configuration for Schema Registry.",
      "properties": {
        "Type": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Authentication type discriminator. Specifies the authentication mechanism for Schema Registry."
        },
        "Username": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Username or Public Key for authentication."
        },
        "Password": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Password or Private Key for authentication. Review [AWS security best practices for CloudFormation](https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/security-best-practices.html#creds) to manage credentials."
        }
      },
      "additionalProperties": false,
      "title": "MongoDBAtlasStreamConnectionSchemaRegistryAuthenticationDefinition"
    }
  },
  "properties": {
    "ProjectId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 24,
          "minLength": 24,
          "pattern": "^([a-f0-9]{24})$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups."
    },
    "Profile": {
      "oneOf": [
        {
          "type": "string",
          "default": "default"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Profile used to provide credentials information, (a secret with the cfn/atlas/profile/{Profile}, is required), if not provided default is used"
    },
    "ConnectionName": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Human-readable label that identifies the stream connection. In the case of the Sample type, this is the name of the sample source."
    },
    "InstanceName": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Human-readable label that identifies the stream instance. WARNING: This field is deprecated and will be removed in the next major release. Please use WorkspaceName instead."
    },
    "WorkspaceName": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Human-readable label that identifies the stream workspace."
    },
    "Type": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Kafka",
            "Cluster",
            "Sample",
            "AWSLambda",
            "Https"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Type of the connection. Can be Cluster, Kafka, Sample, AWSLambda, or Https."
    },
    "ClusterName": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Name of the cluster configured for this connection."
    },
    "ClusterProjectId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 24,
          "minLength": 24,
          "pattern": "^([a-f0-9]{24})$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Unique 24-hexadecimal digit string that identifies the project containing the cluster for cross-project cluster connections."
    },
    "DbRoleToExecute": {
      "$ref": "#/definitions/DBRoleToExecute"
    },
    "Authentication": {
      "$ref": "#/definitions/StreamsKafkaAuthentication"
    },
    "BootstrapServers": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Comma separated list of server addresses."
    },
    "Security": {
      "$ref": "#/definitions/StreamsKafkaSecurity"
    },
    "Config": {
      "$ref": "#/definitions/Config"
    },
    "Networking": {
      "$ref": "#/definitions/Networking"
    },
    "Aws": {
      "$ref": "#/definitions/Aws"
    },
    "Url": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "URL endpoint for HTTPS type connections."
    },
    "Headers": {
      "type": "object",
      "description": "HTTP headers for HTTPS type connections.",
      "patternProperties": {
        "^[A-Za-z0-9-]+$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Provider": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Schema Registry provider."
    },
    "SchemaRegistryAuthentication": {
      "$ref": "#/definitions/SchemaRegistryAuthentication"
    },
    "SchemaRegistryUrls": {
      "type": "array",
      "description": "List of Schema Registry endpoint URLs. Each URL must use the http or https scheme and specify a valid host and optional port.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
          }
        ]
      }
    }
  },
  "primaryIdentifier": [
    "/properties/ProjectId",
    "/properties/ConnectionName",
    "/properties/WorkspaceName",
    "/properties/Profile"
  ],
  "required": [
    "ProjectId",
    "ConnectionName",
    "Type"
  ],
  "createOnlyProperties": [
    "/properties/ProjectId",
    "/properties/InstanceName",
    "/properties/WorkspaceName",
    "/properties/ConnectionName",
    "/properties/Type",
    "/properties/Profile"
  ],
  "writeOnlyProperties": [
    "/properties/Authentication/Password",
    "/properties/Authentication/ClientSecret",
    "/properties/Authentication/SslCertificate",
    "/properties/Authentication/SslKey",
    "/properties/Authentication/SslKeyPassword",
    "/properties/SchemaRegistryAuthentication/Password",
    "/properties/Aws/TestBucket"
  ],
  "tagging": {
    "taggable": false
  },
  "type": "object",
  "title": "MongoDBAtlasStreamConnectionProperties"
}