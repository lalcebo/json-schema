{
  "typeName": "AWS::Amplify::Domain",
  "description": "The AWS::Amplify::Domain resource allows you to connect a custom domain to your app.. Source:- No source definition found, add manually please",
  "additionalProperties": false,
  "properties": {
    "AppId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "d[a-z0-9]+"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "AutoSubDomainCreationPatterns": {
      "type": "array",
      "uniqueItems": false,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "(?s).+"
          },
          {
            "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
          }
        ]
      }
    },
    "AutoSubDomainIAMRole": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^$|^arn:.+:iam::\\d{12}:role.+",
          "maxLength": 1000
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "CertificateSettings": {
      "$ref": "#/definitions/CertificateSettings"
    },
    "DomainName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(((?!-)[A-Za-z0-9-]{0,62}[A-Za-z0-9])\\.)+((?!-)[A-Za-z0-9-]{1,62}[A-Za-z0-9])(\\.)?$",
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "EnableAutoSubDomain": {
      "type": "boolean"
    },
    "SubDomainSettings": {
      "type": "array",
      "uniqueItems": false,
      "items": {
        "$ref": "#/definitions/SubDomainSetting"
      },
      "maxItems": 255
    }
  },
  "definitions": {
    "CertificateSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CertificateType": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "AMPLIFY_MANAGED",
                "CUSTOM"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "CustomCertificateArn": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^arn:aws:acm:[a-z0-9-]+:\\d{12}:certificate\\/.+$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "title": "AWSAmplifyDomainCertificateSettingsDefinition"
    },
    "Certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CertificateType": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "AMPLIFY_MANAGED",
                "CUSTOM"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "CertificateArn": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "\"^arn:aws:acm:[a-z0-9-]+:\\d{12}:certificate\\/.+$\""
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "CertificateVerificationDNSRecord": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "title": "AWSAmplifyDomainCertificateDefinition"
    },
    "SubDomainSetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Prefix": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 255,
              "pattern": "(?s).*"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "BranchName": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "(?s).+"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Prefix",
        "BranchName"
      ],
      "title": "AWSAmplifyDomainSubDomainSettingDefinition"
    }
  },
  "required": [
    "AppId",
    "DomainName",
    "SubDomainSettings"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "createOnlyProperties": [
    "/properties/AppId",
    "/properties/DomainName"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/DomainStatus",
    "/properties/StatusReason",
    "/properties/CertificateRecord",
    "/properties/Certificate",
    "/properties/UpdateStatus"
  ],
  "writeOnlyProperties": [
    "/properties/CertificateSettings"
  ],
  "type": "object",
  "title": "AWSAmplifyDomainProperties"
}