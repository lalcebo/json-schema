    },
    "SingleSignOn": {
      "$ref": "#/definitions/SingleSignOn",
      "description": "The single-sign on configuration of the Amazon DataZone domain."
    },
    "Tags": {
      "type": "array",
      "description": "The tags specified for the Amazon DataZone domain.",
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
