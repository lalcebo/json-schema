{
  "typeName": "AWS::SSO::ApplicationAssignment",
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false
  },
  "description": "Resource Type definition for SSO application access grant to a user or group.. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-sso/aws-sso-application-assignment",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-sso/aws-sso-application-assignment",
  "properties": {
    "ApplicationArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "arn:aws(-[a-z]{1,5}){0,3}:sso::\\d{12}:application/(sso)?ins-[a-zA-Z0-9-.]{16}/apl-[a-zA-Z0-9]{16}",
          "minLength": 10,
          "maxLength": 1224
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ARN of the application."
    },
    "PrincipalType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "USER",
            "GROUP"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The entity type for which the assignment will be created."
    },
    "PrincipalId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([0-9a-f]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$",
          "minLength": 1,
          "maxLength": 47
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "An identifier for an object in IAM Identity Center, such as a user or group"
    }
  },
  "additionalProperties": false,
  "required": [
    "ApplicationArn",
    "PrincipalType",
    "PrincipalId"
  ],
  "createOnlyProperties": [
    "/properties/ApplicationArn",
    "/properties/PrincipalType",
    "/properties/PrincipalId"
  ],
  "primaryIdentifier": [
    "/properties/ApplicationArn",
    "/properties/PrincipalType",
    "/properties/PrincipalId"
  ],
  "type": "object",
  "title": "AWSSSOApplicationAssignmentProperties"
}