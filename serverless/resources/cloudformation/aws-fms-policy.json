      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "NetworkFirewallPolicy"
          ]
        },
        {
          "required": [
            "ThirdPartyFirewallPolicy"
          ]
        },
        {
          "required": [
            "NetworkAclCommonPolicy"
          ]
        }
      ],
      "title": "AWSFMSPolicyPolicyOptionDefinition"
    }
