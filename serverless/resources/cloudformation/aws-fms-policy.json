        "Protocol": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(tcp|udp|icmp|-1|([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Protocol."
        },
        "RuleAction": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "allow",
                "deny"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Rule Action."
        }
      },
      "additionalProperties": false,
      "required": [
        "Egress",
        "Protocol",
        "RuleAction"
      ],
