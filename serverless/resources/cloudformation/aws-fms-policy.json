      "type": "object",
      "properties": {
        "NetworkFirewallPolicy": {
          "$ref": "#/definitions/NetworkFirewallPolicy"
        },
        "ThirdPartyFirewallPolicy": {
          "$ref": "#/definitions/ThirdPartyFirewallPolicy"
        },
        "NetworkAclCommonPolicy": {
          "$ref": "#/definitions/NetworkAclCommonPolicy"
        }
