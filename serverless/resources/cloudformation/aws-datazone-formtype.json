{
  "typeName": "AWS::DataZone::FormType",
  "description": "Create and manage form types in Amazon Datazone. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-datazone.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-datazone.git",
  "definitions": {
    "Model": {
      "type": "object",
      "description": "Indicates the smithy model of the API.",
      "properties": {
        "Smithy": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "AWSDataZoneFormTypeModelDefinition"
    }
  },
  "properties": {
    "DomainIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^dzd[-_][a-zA-Z0-9_-]{1,36}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ID of the Amazon DataZone domain in which this metadata form type is created."
    },
    "Model": {
      "type": "object",
      "description": "The model of this Amazon DataZone metadata form type.",
      "$ref": "#/definitions/Model"
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The description of this Amazon DataZone metadata form type."
    },
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?![0-9_])\\w+$|^_\\w*[a-zA-Z0-9]\\w*$",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of this Amazon DataZone metadata form type."
    },
    "OwningProjectIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,36}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ID of the Amazon DataZone project that owns this metadata form type."
    },
    "Status": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ENABLED",
            "DISABLED"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The status of this Amazon DataZone metadata form type."
    }
  },
  "required": [
    "DomainIdentifier",
    "Model",
    "Name",
    "OwningProjectIdentifier"
  ],
  "readOnlyProperties": [
    "/properties/DomainId",
    "/properties/OwningProjectId",
    "/properties/Revision",
    "/properties/FormTypeIdentifier",
    "/properties/CreatedAt",
    "/properties/CreatedBy"
  ],
  "createOnlyProperties": [
    "/properties/DomainIdentifier",
    "/properties/Name"
  ],
  "conditionalCreateOnlyProperties": [
    "/properties/Description",
    "/properties/Model",
    "/properties/Status",
    "/properties/OwningProjectIdentifier"
  ],
  "primaryIdentifier": [
    "/properties/DomainIdentifier",
    "/properties/FormTypeIdentifier"
  ],
  "additionalIdentifiers": [
    [
      "/properties/Name"
    ]
  ],
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false,
    "cloudFormationSystemTags": false
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSDataZoneFormTypeProperties"
}