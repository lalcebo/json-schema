{
  "typeName": "AWS::MediaConnect::BridgeOutput",
  "description": "Resource schema for AWS::MediaConnect::BridgeOutput. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-mediaconnect.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-mediaconnect.git",
  "definitions": {
    "BridgeNetworkOutput": {
      "type": "object",
      "description": "The output of the bridge. A network output is delivered to your premises.",
      "properties": {
        "Protocol": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "rtp-fec",
                "rtp",
                "udp"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The network output protocol."
        },
        "IpAddress": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The network output IP Address."
        },
        "Port": {
          "type": "integer",
          "description": "The network output port."
        },
        "NetworkName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The network output's gateway network name."
        },
        "Ttl": {
          "type": "integer",
          "description": "The network output TTL."
        }
      },
      "required": [
        "Protocol",
        "IpAddress",
        "Port",
        "NetworkName",
        "Ttl"
      ],
      "additionalProperties": false,
      "title": "AWSMediaConnectBridgeOutputBridgeNetworkOutputDefinition"
    }
  },
  "properties": {
    "BridgeArn": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Amazon Resource Number (ARN) of the bridge."
    },
    "NetworkOutput": {
      "description": "The output of the bridge.",
      "$ref": "#/definitions/BridgeNetworkOutput"
    },
    "Name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The network output name."
    }
  },
  "additionalProperties": false,
  "required": [
    "BridgeArn",
    "Name",
    "NetworkOutput"
  ],
  "createOnlyProperties": [
    "/properties/BridgeArn",
    "/properties/Name"
  ],
  "primaryIdentifier": [
    "/properties/BridgeArn",
    "/properties/Name"
  ],
  "propertyTransform": {
    "/properties/Name": "$join([\"Output:\",Name])"
  },
  "tagging": {
    "taggable": false
  },
  "type": "object",
  "title": "AWSMediaConnectBridgeOutputProperties"
}