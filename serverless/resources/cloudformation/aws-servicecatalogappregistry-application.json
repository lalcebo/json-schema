      "/properties/Name"
    ]
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "servicecatalog:TagResource",
      "servicecatalog:UntagResource",
      "servicecatalog:ListTagsForResource"
    ]
