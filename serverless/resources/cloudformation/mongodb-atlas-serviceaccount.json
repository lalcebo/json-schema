{
  "typeName": "MongoDB::Atlas::ServiceAccount",
  "description": "Creates and manages a Service Account for an organization.. Source:- https://github.com/mongodb/mongodbatlas-cloudformation-resources",
  "sourceUrl": "https://github.com/mongodb/mongodbatlas-cloudformation-resources",
  "definitions": {
    "Secret": {
      "type": "object",
      "properties": {
        "Id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Unique identifier of the secret."
        },
        "CreatedAt": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Date and time that the secret was created on."
        },
        "ExpiresAt": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Date and time when the secret expires."
        },
        "LastUsedAt": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Date and time when the secret was last used."
        },
        "MaskedSecretValue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Masked value of the secret."
        },
        "Secret": {
          "oneOf": [
            {
              "type": "string",
              "format": "password"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The secret value. Only returned on create."
        }
      },
      "additionalProperties": false,
      "title": "MongoDBAtlasServiceAccountSecretDefinition"
    }
  },
  "properties": {
    "Profile": {
      "oneOf": [
        {
          "type": "string",
          "default": "default"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Profile used to provide credentials information."
    },
    "OrgId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 24,
          "minLength": 24,
          "pattern": "^([a-f0-9]{24})$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Unique 24-hexadecimal digit string that identifies the organization."
    },
    "Name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Human-readable name for the Service Account."
    },
    "Description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Human readable description for the Service Account."
    },
    "Roles": {
      "type": "array",
      "description": "List of organization-level roles for the Service Account.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
          }
        ]
      },
      "minItems": 1
    },
    "SecretExpiresAfterHours": {
      "type": "integer",
      "description": "Expiration time of the new Service Account secret in hours.",
      "minimum": 1
    }
  },
  "required": [
    "OrgId",
    "Name",
    "Description",
    "Roles",
    "SecretExpiresAfterHours"
  ],
  "readOnlyProperties": [
    "/properties/ClientId",
    "/properties/CreatedAt",
    "/properties/Secrets"
  ],
  "createOnlyProperties": [
    "/properties/OrgId",
    "/properties/Profile",
    "/properties/SecretExpiresAfterHours"
  ],
  "primaryIdentifier": [
    "/properties/OrgId",
    "/properties/ClientId",
    "/properties/Profile"
  ],
  "tagging": {
    "taggable": false
  },
  "additionalProperties": false,
  "type": "object",
  "title": "MongoDBAtlasServiceAccountProperties"
}