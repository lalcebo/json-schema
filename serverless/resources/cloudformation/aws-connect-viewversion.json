{
  "typeName": "AWS::Connect::ViewVersion",
  "description": "Resource Type definition for AWS::Connect::ViewVersion. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-connect",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-connect",
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false,
    "cloudFormationSystemTags": false
  },
  "properties": {
    "ViewArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws[-a-z0-9]*:connect:[-a-z0-9]*:[0-9]{12}:instance/[-a-zA-Z0-9]*/view/[-:a-zA-Z0-9]*$",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Amazon Resource Name (ARN) of the view for which a version is being created."
    },
    "VersionDescription": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^([\\p{L}\\p{N}_.:\\/=+\\-@,]+[\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@,]*)$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The description for the view version."
    },
    "ViewContentSha256": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9]{64}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The view content hash to be checked."
    }
  },
  "required": [
    "ViewArn"
  ],
  "propertyTransform": {
    "/properties/ViewArn": "$join([\"^\", ViewArn, \":[0-9]*$\"])"
  },
  "additionalProperties": false,
  "primaryIdentifier": [
    "/properties/ViewVersionArn"
  ],
  "readOnlyProperties": [
    "/properties/ViewVersionArn",
    "/properties/Version"
  ],
  "createOnlyProperties": [
    "/properties/ViewArn",
    "/properties/ViewContentSha256"
  ],
  "type": "object",
  "title": "AWSConnectViewVersionProperties"
}