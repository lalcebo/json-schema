{
  "typeName": "AWS::BedrockAgentCore::CodeInterpreterCustom",
  "description": "Resource definition for AWS::BedrockAgentCore::CodeInterpreterCustom. Source:- https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "definitions": {
    "CodeInterpreterId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(aws\\.codeinterpreter\\.v1|[a-zA-Z][a-zA-Z0-9_]{0,47}-[a-zA-Z0-9]{10})$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The id of the code interpreter.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterIdDefinition"
    },
    "CodeInterpreterArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:(aws(?:-cn|-us-gov|-iso(?:-[bef])?)?):bedrock-agentcore:[a-z0-9-]+:(aws|[0-9]{12}):code-interpreter(-custom)?\\/(aws\\.codeinterpreter\\.v1|[a-zA-Z][a-zA-Z0-9_]{0,47}-[a-zA-Z0-9]{10})$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ARN of a CodeInterpreter resource.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterArnDefinition"
    },
    "CodeInterpreterNetworkMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "PUBLIC",
            "SANDBOX",
            "VPC"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Network modes supported by code interpreter",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterNetworkModeDefinition"
    },
    "CodeInterpreterNetworkConfiguration": {
      "type": "object",
      "properties": {
        "NetworkMode": {
          "$ref": "#/definitions/CodeInterpreterNetworkMode",
          "default": "SANDBOX"
        },
        "VpcConfig": {
          "$ref": "#/definitions/VpcConfig"
        }
      },
      "required": [
        "NetworkMode"
      ],
      "additionalProperties": false,
      "description": "Network configuration for code interpreter",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterNetworkConfigurationDefinition"
    },
    "SandboxName": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the sandbox.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomSandboxNameDefinition"
    },
    "Description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Description of the code interpreter.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomDescriptionDefinition"
    },
    "RoleArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:(aws(?:-cn|-us-gov|-iso(?:-[bef])?)?):iam::[0-9]{12}:role/.+$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ARN of the IAM role.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomRoleArnDefinition"
    },
    "CodeInterpreterStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "CREATING",
            "CREATE_FAILED",
            "READY",
            "DELETING",
            "DELETE_FAILED",
            "DELETED"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Status of Code interpreter",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterStatusDefinition"
    },
    "CodeInterpreterSummary": {
      "type": "object",
      "properties": {
        "CodeInterpreterId": {
          "$ref": "#/definitions/CodeInterpreterId"
        },
        "CodeInterpreterArn": {
          "$ref": "#/definitions/CodeInterpreterArn"
        },
        "Name": {
          "$ref": "#/definitions/SandboxName"
        },
        "Description": {
          "$ref": "#/definitions/Description"
        },
        "Status": {
          "$ref": "#/definitions/CodeInterpreterStatus"
        },
        "CreatedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "LastUpdatedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "CodeInterpreterId",
        "CodeInterpreterArn",
        "Status",
        "CreatedAt"
      ],
      "additionalProperties": false,
      "description": "Code Interpreter",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterSummaryDefinition"
    },
    "CodeInterpreterSummaries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CodeInterpreterSummary"
      },
      "description": "List of code interpreters",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCodeInterpreterSummariesDefinition"
    },
    "VpcConfig": {
      "type": "object",
      "description": "Network mode configuration for VPC",
      "properties": {
        "SecurityGroups": {
