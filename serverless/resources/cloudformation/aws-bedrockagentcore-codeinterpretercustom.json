        "Subnets": {
          "$ref": "#/definitions/Subnets"
        }
      },
      "required": [
        "SecurityGroups",
        "Subnets"
      ],
      "additionalProperties": false,
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomVpcConfigDefinition"
    },
    "SecurityGroups": {
      "type": "array",
      "description": "Security groups for VPC",
      "minItems": 1,
      "maxItems": 16,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/SecurityGroupId"
      },
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomSecurityGroupsDefinition"
    },
    "SecurityGroupId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sg-[0-9a-zA-Z]{8,17}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Security group id",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomSecurityGroupIdDefinition"
    },
    "Subnets": {
      "type": "array",
      "description": "Subnets for VPC",
      "minItems": 1,
      "maxItems": 16,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/SubnetId"
      },
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomSubnetsDefinition"
    },
    "SubnetId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^subnet-[0-9a-zA-Z]{8,17}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Subnet id",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomSubnetIdDefinition"
    },
    "TagsMap": {
      "type": "object",
      "description": "A map of tag keys and values",
      "patternProperties": {
        "^[a-zA-Z0-9\\s._:/=+@-]*$": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 0,
              "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Value of a tag"
        }
      },
      "additionalProperties": false,
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomTagsMapDefinition"
    },
    "CertificateLocation": {
      "type": "object",
      "properties": {
        "SecretArn": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^arn:(aws(?:-cn|-us-gov|-iso(?:-[bef])?)?):secretsmanager:[a-z0-9-]+:\\d{12}:secret:[a-zA-Z0-9/_+=.@-]+$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Secrets Manager secret ARN."
        }
      },
      "required": [
        "SecretArn"
      ],
      "additionalProperties": false,
      "description": "Certificate location in Secrets Manager.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCertificateLocationDefinition"
    },
    "Certificate": {
      "type": "object",
      "properties": {
        "CertificateLocation": {
          "$ref": "#/definitions/CertificateLocation",
          "description": "Certificate location in Secrets Manager."
        }
      },
      "required": [
        "CertificateLocation"
      ],
      "additionalProperties": false,
      "description": "A root CA certificate configuration.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCertificateDefinition"
    },
    "CertificateList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Certificate"
      },
      "insertionOrder": false,
      "minItems": 0,
      "maxItems": 10,
      "description": "List of root CA certificates.",
      "title": "AWSBedrockAgentCoreCodeInterpreterCustomCertificateListDefinition"
    }
  },
  "properties": {
    "Name": {
      "$ref": "#/definitions/SandboxName",
      "description": "The name of the code interpreter."
    },
    "Description": {
      "$ref": "#/definitions/Description",
      "description": "The description of the code interpreter."
    },
    "ExecutionRoleArn": {
      "$ref": "#/definitions/RoleArn",
      "description": "The ARN of the IAM role that the code interpreter uses to access resources."
    },
    "NetworkConfiguration": {
      "$ref": "#/definitions/CodeInterpreterNetworkConfiguration",
      "description": "Network configuration for code interpreter."
    },
    "Certificates": {
      "$ref": "#/definitions/CertificateList",
      "description": "List of root CA certificates in PEM format."
    },
    "Tags": {
      "$ref": "#/definitions/TagsMap"
    }
