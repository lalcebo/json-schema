{
  "typeName": "AWS::Bedrock::FlowAlias",
  "description": "Definition of AWS::Bedrock::FlowAlias Resource Type. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-bedrock-flows",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-bedrock-flows",
  "definitions": {
    "ConcurrencyType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Automatic",
            "Manual"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSBedrockFlowAliasConcurrencyTypeDefinition"
    },
    "FlowAliasConcurrencyConfiguration": {
      "type": "object",
      "properties": {
        "Type": {
          "$ref": "#/definitions/ConcurrencyType"
        },
        "MaxConcurrency": {
          "type": "number",
          "maximum": 100,
          "minimum": 1,
          "description": "Number of nodes executed concurrently at a time"
        }
      },
      "required": [
        "Type"
      ],
      "additionalProperties": false,
      "title": "AWSBedrockFlowAliasFlowAliasConcurrencyConfigurationDefinition"
    },
    "FlowAliasRoutingConfigurationListItem": {
      "type": "object",
      "description": "Details about the routing configuration for a Flow alias.",
      "properties": {
        "FlowVersion": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 5,
              "minLength": 1,
              "pattern": "^(DRAFT|[0-9]{0,4}[1-9][0-9]{0,4})$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Version."
        }
      },
      "additionalProperties": false,
      "title": "AWSBedrockFlowAliasFlowAliasRoutingConfigurationListItemDefinition"
    },
    "TagsMap": {
      "type": "object",
      "description": "A map of tag keys and values",
      "patternProperties": {
        "^[a-zA-Z0-9\\s._:/=+@-]*$": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 0,
              "pattern": "^[a-zA-Z0-9\\s._:/=+@-]*$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Value of a tag"
        }
      },
      "additionalProperties": false,
      "title": "AWSBedrockFlowAliasTagsMapDefinition"
    }
  },
  "properties": {
    "FlowArn": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^arn:aws(-[^:]+)?:bedrock:[a-z0-9-]{1,20}:[0-9]{12}:flow/[0-9a-zA-Z]{10}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Arn representation of the Flow"
    },
    "ConcurrencyConfiguration": {
      "$ref": "#/definitions/FlowAliasConcurrencyConfiguration"
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Description of the Resource."
    },
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([0-9a-zA-Z][_-]?){1,100}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Name for a resource."
    },
    "RoutingConfiguration": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FlowAliasRoutingConfigurationListItem"
      },
      "maxItems": 1,
      "minItems": 1,
      "description": "Routing configuration for a Flow alias.",
      "insertionOrder": true
    },
    "Tags": {
      "$ref": "#/definitions/TagsMap"
    }
  },
  "required": [
    "Name",
    "FlowArn",
    "RoutingConfiguration"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/CreatedAt",
    "/properties/FlowId",
    "/properties/Id",
    "/properties/UpdatedAt"
  ],
  "createOnlyProperties": [
    "/properties/FlowArn"
  ],
  "primaryIdentifier": [
    "/properties/Arn",
    "/properties/FlowArn"
  ],
  "tagging": {
    "cloudFormationSystemTags": false,
    "tagOnCreate": true,
    "tagProperty": "/properties/Tags",
    "tagUpdatable": true,
    "taggable": true,
    "permissions": [
      "bedrock:TagResource",
      "bedrock:UntagResource",
      "bedrock:ListTagsForResource"
    ]
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSBedrockFlowAliasProperties"
}