            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Service"
      ]
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 255
        },
