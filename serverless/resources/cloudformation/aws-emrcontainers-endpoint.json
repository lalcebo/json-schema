{
  "typeName": "AWS::EMRContainers::Endpoint",
  "description": "Resource Schema of AWS::EMRContainers::Endpoint Type. Source:- https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "additionalIdentifiers": [
    [
      "/properties/VirtualClusterId",
      "/properties/Id"
    ]
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/Id",
    "/properties/ServerUrl",
    "/properties/State",
    "/properties/StateDetails",
    "/properties/FailureReason",
    "/properties/CreatedAt",
    "/properties/SecurityGroup",
    "/properties/CertificateAuthority"
  ],
  "createOnlyProperties": [
    "/properties/Name",
    "/properties/VirtualClusterId",
    "/properties/Type",
    "/properties/ReleaseLabel",
    "/properties/ExecutionRoleArn",
    "/properties/ConfigurationOverrides"
  ],
  "definitions": {
    "ConfigurationOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ApplicationConfiguration": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/EMREKSConfiguration"
          }
        },
        "MonitoringConfiguration": {
          "$ref": "#/definitions/MonitoringConfiguration"
        }
      },
      "title": "AWSEMRContainersEndpointConfigurationOverridesDefinition"
    },
    "EMREKSConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Classification": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Properties": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "Configurations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/EMREKSConfiguration"
          }
        }
      },
      "required": [
        "Classification"
      ],
      "title": "AWSEMRContainersEndpointEMREKSConfigurationDefinition"
    },
    "MonitoringConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PersistentAppUI": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ENABLED",
                "DISABLED"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "ContainerLogRotationConfiguration": {
          "$ref": "#/definitions/ContainerLogRotationConfiguration"
        },
        "CloudWatchMonitoringConfiguration": {
          "$ref": "#/definitions/CloudWatchMonitoringConfiguration"
        },
        "S3MonitoringConfiguration": {
          "$ref": "#/definitions/S3MonitoringConfiguration"
        }
      },
      "title": "AWSEMRContainersEndpointMonitoringConfigurationDefinition"
    },
    "ContainerLogRotationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "RotationSize": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "MaxFilesToKeep": {
          "type": "integer"
        }
      },
      "required": [
        "RotationSize",
        "MaxFilesToKeep"
      ],
      "title": "AWSEMRContainersEndpointContainerLogRotationConfigurationDefinition"
    },
    "CloudWatchMonitoringConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LogGroupName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "LogStreamNamePrefix": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "LogGroupName"
      ],
      "title": "AWSEMRContainersEndpointCloudWatchMonitoringConfigurationDefinition"
    },
    "S3MonitoringConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LogUri": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "LogUri"
      ],
      "title": "AWSEMRContainersEndpointS3MonitoringConfigurationDefinition"
    },
    "Certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CertificateArn": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "CertificateData": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "title": "AWSEMRContainersEndpointCertificateDefinition"
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A user-defined key, which is the minimum required information for a valid tag."
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A user-defined value, which is optional in a tag."
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "title": "AWSEMRContainersEndpointTagDefinition"
    }
  },
  "properties": {
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[0-9A-Za-z][A-Za-z0-9\\-_]*"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the managed endpoint."
    },
    "VirtualClusterId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ID of the virtual cluster for which the managed endpoint is created."
    },
    "Type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The type of the managed endpoint."
    },
    "ReleaseLabel": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[A-Za-z0-9._/-]+"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The Amazon EMR release label."
    },
    "ExecutionRoleArn": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The execution role ARN for the managed endpoint."
    },
    "ConfigurationOverrides": {
      "description": "The configuration overrides for the managed endpoint.",
      "$ref": "#/definitions/ConfigurationOverrides"
    },
    "Tags": {
      "description": "An array of key-value pairs to apply to this managed endpoint.",
      "type": "array",
      "uniqueItems": true,
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "maxItems": 50
    }
  },
  "additionalProperties": false,
  "required": [
    "VirtualClusterId",
    "Type",
    "ReleaseLabel",
    "ExecutionRoleArn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "emr-containers:TagResource",
      "emr-containers:UntagResource",
      "emr-containers:ListTagsForResource"
    ]
  },
  "type": "object",
  "title": "AWSEMRContainersEndpointProperties"
}