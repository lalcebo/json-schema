          "$ref": "#/definitions/AttributeName"
        },
        "Type": {
          "$ref": "#/definitions/SchemaAttributeType"
        },
        "SubType": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The subtype of the Attribute. Would be required only when type is PROVIDER_ID"
        },
        "GroupName": {
          "$ref": "#/definitions/AttributeName"
        },
        "MatchKey": {
          "$ref": "#/definitions/AttributeName"
        },
        "Hashed": {
          "$ref": "#/definitions/Hashed"
        }
      },
      "required": [
        "FieldName",
        "Type"
      ],
      "additionalProperties": false,
      "title": "AWSEntityResolutionSchemaMappingSchemaInputAttributeDefinition"
    },
    "SchemaMappingArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:(aws|aws-us-gov|aws-cn):entityresolution:.*:[0-9]+:(schemamapping/.*)$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The SchemaMapping arn associated with the Schema",
      "title": "AWSEntityResolutionSchemaMappingSchemaMappingArnDefinition"
    },
    "CreatedAt": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The time of this SchemaMapping got created",
      "title": "AWSEntityResolutionSchemaMappingCreatedAtDefinition"
    },
    "UpdatedAt": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The time of this SchemaMapping got last updated at",
      "title": "AWSEntityResolutionSchemaMappingUpdatedAtDefinition"
