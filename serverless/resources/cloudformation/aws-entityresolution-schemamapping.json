{
  "typeName": "AWS::EntityResolution::SchemaMapping",
  "description": "SchemaMapping defined in AWS Entity Resolution service. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-entity-resolution.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-entity-resolution.git",
  "definitions": {
    "EntityName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z_0-9-]*$",
          "minLength": 0,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionSchemaMappingEntityNameDefinition"
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionSchemaMappingDescriptionDefinition"
    },
    "AttributeName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z_0-9- \\t]*$",
          "minLength": 0,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSEntityResolutionSchemaMappingAttributeNameDefinition"
