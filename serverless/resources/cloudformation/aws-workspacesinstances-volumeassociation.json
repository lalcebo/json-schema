{
  "typeName": "AWS::WorkspacesInstances::VolumeAssociation",
  "description": "Resource Type definition for AWS::WorkspacesInstances::VolumeAssociation. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-schema.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-schema.git",
  "properties": {
    "WorkspaceInstanceId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^wsinst-[0-9a-zA-Z]{8,63}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "ID of the workspace instance to associate with the volume"
    },
    "VolumeId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^vol-[0-9a-zA-Z]{1,63}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "ID of the volume to attach to the workspace instance"
    },
    "Device": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 32
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The device name for the volume attachment"
    },
    "DisassociateMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "FORCE",
            "NO_FORCE"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Mode to use when disassociating the volume"
    }
  },
  "required": [
    "WorkspaceInstanceId",
    "VolumeId",
    "Device"
  ],
  "createOnlyProperties": [
    "/properties/WorkspaceInstanceId",
    "/properties/VolumeId",
    "/properties/Device"
  ],
  "writeOnlyProperties": [
    "/properties/DisassociateMode"
  ],
  "primaryIdentifier": [
    "/properties/WorkspaceInstanceId",
    "/properties/VolumeId",
    "/properties/Device"
  ],
  "tagging": {
    "taggable": false,
    "tagOnCreate": false,
    "tagUpdatable": false,
    "cloudFormationSystemTags": false
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSWorkspacesInstancesVolumeAssociationProperties"
}