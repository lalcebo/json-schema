{
  "typeName": "AWS::M2::Application",
  "description": "Represents an application that runs on an AWS Mainframe Modernization Environment. Source:- No source definition found, add manually please",
  "definitions": {
    "Definition": {
      "oneOf": [
        {
          "type": "object",
          "title": "S3Location",
          "properties": {
            "S3Location": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\S{1,2000}$"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ]
            }
          },
          "required": [
            "S3Location"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Content",
          "properties": {
            "Content": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 65000,
                  "minLength": 1
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ]
            }
          },
          "required": [
            "Content"
          ],
          "additionalProperties": false
        }
      ],
      "title": "AWSM2ApplicationDefinition"
    },
    "EngineType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "microfocus",
            "bluage"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSM2ApplicationEngineTypeDefinition"
    },
    "TagMap": {
      "type": "object",
      "maxProperties": 200,
      "minProperties": 0,
      "patternProperties": {
        "^(?!aws:).+$": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 0
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "AWSM2ApplicationTagMapDefinition"
    }
  },
  "properties": {
    "Definition": {
      "$ref": "#/definitions/Definition"
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 500,
          "minLength": 0
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "EngineType": {
      "$ref": "#/definitions/EngineType"
    },
    "KmsKeyId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ID or the Amazon Resource Name (ARN) of the customer managed KMS Key used for encrypting application-related resources."
    },
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{1,59}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "RoleArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:(aws|aws-cn|aws-iso|aws-iso-[a-z]{1}|aws-us-gov):[A-Za-z0-9][A-Za-z0-9_/.-]{0,62}:([a-z]{2}-((iso[a-z]{0,1}-)|(gov-)){0,1}[a-z]+-[0-9]|):[0-9]{12}:[A-Za-z0-9/][A-Za-z0-9:_/+=,@.-]{0,1023}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "Tags": {
      "$ref": "#/definitions/TagMap"
    }
  },
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "m2:TagResource",
      "m2:UntagResource",
      "m2:ListTagsForResource"
    ]
  },
  "required": [
    "EngineType",
    "Name"
  ],
  "readOnlyProperties": [
    "/properties/ApplicationArn",
    "/properties/ApplicationId"
  ],
  "writeOnlyProperties": [
    "/properties/Definition"
  ],
  "createOnlyProperties": [
    "/properties/EngineType",
    "/properties/Name",
    "/properties/KmsKeyId",
    "/properties/RoleArn"
  ],
  "primaryIdentifier": [
    "/properties/ApplicationArn"
  ],
  "additionalProperties": false,
  "type": "object",
  "title": "AWSM2ApplicationProperties"
}