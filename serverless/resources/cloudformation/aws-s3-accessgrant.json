{
  "typeName": "AWS::S3::AccessGrant",
  "description": "The AWS::S3::AccessGrant resource is an Amazon S3 resource type representing permissions to a specific S3 bucket or prefix hosted in an S3 Access Grants instance. . Source:- https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "definitions": {
    "Grantee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GranteeType": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "IAM",
                "DIRECTORY_USER",
                "DIRECTORY_GROUP"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Configures the transfer acceleration state for an Amazon S3 bucket."
        },
        "GranteeIdentifier": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The unique identifier of the Grantee"
        }
      },
      "required": [
        "GranteeType",
        "GranteeIdentifier"
      ],
      "title": "AWSS3AccessGrantGranteeDefinition"
    },
    "AccessGrantsLocationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "S3SubPrefix": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The S3 sub prefix of a registered location in your S3 Access Grants instance"
        }
      },
      "required": [
        "S3SubPrefix"
      ],
      "title": "AWSS3AccessGrantAccessGrantsLocationConfigurationDefinition"
    },
    "AccessGrantArn": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "the Amazon Resource Name (ARN) of the specified access grant.",
      "title": "AWSS3AccessGrantAccessGrantArnDefinition"
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Value",
        "Key"
      ],
      "title": "AWSS3AccessGrantTagDefinition"
    }
  },
  "properties": {
    "AccessGrantsLocationId": {
      "oneOf": [
        {
          "type": "string",
          "examples": [
            "125f332b-a499-4eb6-806f-8a6a1aa4cb96"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The custom S3 location to be accessed by the grantee"
    },
    "Tags": {
      "type": "array",
      "insertionOrder": false,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    },
    "Permission": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "READ",
            "WRITE",
            "READWRITE"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The level of access to be afforded to the grantee"
    },
    "ApplicationArn": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ARN of the application grantees will use to access the location"
    },
    "S3PrefixType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Object"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The type of S3SubPrefix."
    },
    "Grantee": {
      "$ref": "#/definitions/Grantee",
      "description": "The principal who will be granted permission to access S3."
    },
    "AccessGrantsLocationConfiguration": {
      "$ref": "#/definitions/AccessGrantsLocationConfiguration",
      "description": "The configuration options of the grant location, which is the S3 path to the data to which you are granting access."
    }
  },
  "required": [
    "Grantee",
    "Permission",
    "AccessGrantsLocationId"
  ],
  "createOnlyProperties": [
    "/properties/S3PrefixType",
    "/properties/Tags"
  ],
  "writeOnlyProperties": [
    "/properties/S3PrefixType"
  ],
  "readOnlyProperties": [
    "/properties/AccessGrantId",
    "/properties/AccessGrantArn",
    "/properties/GrantScope"
  ],
  "primaryIdentifier": [
    "/properties/AccessGrantId"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": false,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "s3:UntagResource",
      "s3:TagResource",
      "s3:ListTagsForResource"
    ]
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSS3AccessGrantProperties"
}