{
  "typeName": "AWS::CodeArtifact::PackageGroup",
  "description": "The resource schema to create a CodeArtifact package group.. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-codeartifact",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-codeartifact",
  "definitions": {
    "Tag": {
      "description": "A key-value pair to associate with a resource.",
      "type": "object",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The key name of the tag. You can specify a value that is 1 to 128 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -. "
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the tag. You can specify a value that is 1 to 256 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -. "
        }
      },
      "required": [
        "Value",
        "Key"
      ],
      "additionalProperties": false,
      "title": "AWSCodeArtifactPackageGroupTagDefinition"
    },
    "OriginConfiguration": {
      "type": "object",
      "properties": {
        "Restrictions": {
          "description": "The origin configuration that is applied to the package group.",
          "type": "object",
          "$ref": "#/definitions/Restrictions"
        }
      },
      "required": [
        "Restrictions"
      ],
      "additionalProperties": false,
      "title": "AWSCodeArtifactPackageGroupOriginConfigurationDefinition"
    },
    "Restrictions": {
      "type": "object",
      "properties": {
        "Publish": {
          "type": "object",
          "description": "The publish restriction determines if new package versions can be published.",
          "$ref": "#/definitions/RestrictionType"
        },
        "ExternalUpstream": {
          "type": "object",
          "description": "The external upstream restriction determines if new package versions can be ingested or retained from external connections.",
          "$ref": "#/definitions/RestrictionType"
        },
        "InternalUpstream": {
          "type": "object",
          "description": "The internal upstream restriction determines if new package versions can be ingested or retained from upstream repositories.",
          "$ref": "#/definitions/RestrictionType"
        }
      },
      "additionalProperties": false,
      "title": "AWSCodeArtifactPackageGroupRestrictionsDefinition"
    },
    "RestrictionType": {
      "type": "object",
      "properties": {
        "RestrictionMode": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ALLOW",
                "BLOCK",
                "ALLOW_SPECIFIC_REPOSITORIES",
                "INHERIT"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Repositories": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          }
        }
      },
      "required": [
        "RestrictionMode"
      ],
      "additionalProperties": false,
      "title": "AWSCodeArtifactPackageGroupRestrictionTypeDefinition"
    }
  },
  "properties": {
    "DomainName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([a-z][a-z0-9\\-]{0,48}[a-z0-9])$",
          "minLength": 2,
          "maxLength": 50
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the domain that contains the package group."
    },
    "DomainOwner": {
      "oneOf": [
        {
          "pattern": "[0-9]{12}",
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The 12-digit account ID of the AWS account that owns the domain."
    },
    "Pattern": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 520
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The package group pattern that is used to gather packages."
    },
    "ContactInfo": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The contact info of the package group."
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The text description of the package group."
    },
    "OriginConfiguration": {
      "description": "The package origin configuration of the package group.",
      "type": "object",
      "$ref": "#/definitions/OriginConfiguration"
    },
    "Tags": {
      "type": "array",
      "description": "An array of key-value pairs to apply to the package group.",
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "Pattern",
    "DomainName"
  ],
  "createOnlyProperties": [
    "/properties/DomainName",
    "/properties/Pattern"
  ],
  "readOnlyProperties": [
    "/properties/Arn"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "codeartifact:ListTagsForResource",
      "codeartifact:UntagResource",
      "codeartifact:TagResource"
    ]
  },
  "type": "object",
  "title": "AWSCodeArtifactPackageGroupProperties"
}