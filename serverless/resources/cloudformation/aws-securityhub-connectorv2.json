{
  "typeName": "AWS::SecurityHub::ConnectorV2",
  "description": "Resource schema for AWS::SecurityHub::ConnectorV2. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-securityhub",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-securityhub",
  "definitions": {
    "Tags": {
      "description": "A key-value pair to associate with a resource.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(?!aws:)[a-zA-Z+-=._:/]{1,128}$": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the tag. You can specify a value that is 0 to 256 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -."
        }
      },
      "title": "AWSSecurityHubConnectorV2TagsDefinition"
    },
    "ISO8601DateString": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(\\d\\d\\d\\d)-([0][1-9]|[1][0-2])-([0][1-9]|[1-2](\\d)|[3][0-1])[T](?:([0-1](\\d)|[2][0-3]):[0-5](\\d):[0-5](\\d)|23:59:60)(?:\\.(\\d)+)?([Z]|[+-](\\d\\d)(:?(\\d\\d))?)$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The timestamp formatted in ISO8601",
      "title": "AWSSecurityHubConnectorV2ISO8601DateStringDefinition"
    },
    "AuthStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ACTIVE",
            "FAILED"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The authorization status of the connector",
      "title": "AWSSecurityHubConnectorV2AuthStatusDefinition"
    },
    "JiraCloudProviderConfiguration": {
      "type": "object",
      "description": "The initial configuration settings required to establish an integration between Security Hub and Jira Cloud",
      "properties": {
        "ProjectKey": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 10
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The project key for a Jira Cloud instance"
        }
      },
      "required": [
        "ProjectKey"
      ],
      "additionalProperties": false,
      "title": "AWSSecurityHubConnectorV2JiraCloudProviderConfigurationDefinition"
    },
    "ServiceNowProviderConfiguration": {
      "type": "object",
      "description": "The initial configuration settings required to establish an integration between Security Hub and ServiceNow ITSM",
      "properties": {
        "InstanceName": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The instance name of ServiceNow ITSM"
        },
        "SecretArn": {
          "oneOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*",
              "minLength": 20,
              "maxLength": 2048
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The Amazon Resource Name (ARN) of the AWS Secrets Manager secret that contains the ServiceNow credentials"
        }
      },
      "required": [
        "InstanceName",
        "SecretArn"
      ],
      "additionalProperties": false,
      "title": "AWSSecurityHubConnectorV2ServiceNowProviderConfigurationDefinition"
    },
    "Provider": {
      "type": "object",
      "description": "The third-party provider configuration for the connector",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "JiraCloud": {
              "$ref": "#/definitions/JiraCloudProviderConfiguration"
            }
          },
          "required": [
            "JiraCloud"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ServiceNow": {
              "$ref": "#/definitions/ServiceNowProviderConfiguration"
            }
          },
          "required": [
            "ServiceNow"
          ],
          "additionalProperties": false
        }
      ],
      "title": "AWSSecurityHubConnectorV2ProviderDefinition"
    }
  },
  "properties": {
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": ".*\\S.*",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The name of the connector"
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "pattern": ".*\\S.*",
          "minLength": 0,
          "maxLength": 256
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "A description of the connector"
    },
    "KmsKeyArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": ".*\\S.*",
          "minLength": 20,
          "maxLength": 2048
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The ARN of KMS key used for the connector"
    },
    "Provider": {
      "$ref": "#/definitions/Provider"
    },
    "Tags": {
      "$ref": "#/definitions/Tags"
    }
  },
  "required": [
    "Name",
    "Provider"
  ],
  "createOnlyProperties": [
    "/properties/Name",
    "/properties/KmsKeyArn",
    "/properties/Provider/ServiceNow/InstanceName"
  ],
  "readOnlyProperties": [
    "/properties/ConnectorArn",
    "/properties/ConnectorId",
    "/properties/Message",
    "/properties/ConnectorStatus",
    "/properties/LastUpdatedAt",
    "/properties/LastCheckedAt",
    "/properties/CreatedAt"
  ],
  "primaryIdentifier": [
    "/properties/ConnectorArn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "securityhub:ListTagsForResource",
      "securityhub:TagResource",
      "securityhub:UntagResource"
    ]
  },
  "additionalProperties": false,
  "type": "object",
  "title": "AWSSecurityHubConnectorV2Properties"
}