{
  "typeName": "AWS::IVS::PublicKey",
  "description": "Resource Type definition for AWS::IVS::PublicKey. Source:- https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false,
      "title": "AWSIVSPublicKeyTagDefinition"
    }
  },
  "properties": {
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-_]*$",
          "minLength": 0,
          "maxLength": 128
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Name of the public key to be imported. The value does not need to be unique."
    },
    "PublicKeyMaterial": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "-----BEGIN PUBLIC KEY-----\\r?\\n([a-zA-Z0-9+/=\\r\\n]+)\\r?\\n-----END PUBLIC KEY-----(\\r?\\n)?"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The public portion of a customer-generated key pair. This field is required to create the AWS::IVS::PublicKey resource."
    },
    "Tags": {
      "description": "A list of key-value pairs that contain metadata for the asset model.",
      "type": "array",
      "uniqueItems": true,
      "insertionOrder": false,
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "additionalProperties": false,
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "ivs:TagResource",
      "ivs:UntagResource",
      "ivs:ListTagsForResource"
    ]
  },
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/Fingerprint"
  ],
  "createOnlyProperties": [
    "/properties/PublicKeyMaterial",
    "/properties/Name"
  ],
  "type": "object",
  "title": "AWSIVSPublicKeyProperties"
}