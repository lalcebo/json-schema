              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "UserBase": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "UserSearchSubtree": {
          "type": "boolean"
        },
        "RoleSearchMatching": {
          "oneOf": [
            {
              "type": "string"
            },
