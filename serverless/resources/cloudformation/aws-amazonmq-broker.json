    "User": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ReplicationUser": {
          "type": "boolean"
        },
        "ConsoleAccess": {
          "type": "boolean"
        },
        "Username": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.~-]{2,100}$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Groups": {
          "type": "array",
