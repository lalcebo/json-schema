{
  "typeName": "AWS::AmazonMQ::Broker",
  "description": "Resource type definition for AWS::AmazonMQ::Broker. Source:- No source definition found, add manually please",
  "additionalProperties": false,
  "properties": {
    "BrokerName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-Za-z_-]{1,50}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "EngineType": {
      "oneOf": [
        {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "ACTIVEMQ",
                "RABBITMQ"
              ],
              "type": "string"
            },
            {
              "pattern": "^[Aa][Cc][Tt][Ii][Vv][Ee][Mm][Qq]$"
            },
            {
              "pattern": "^[Rr][Aa][Bb][Bb][Ii][Tt][Mm][Qq]$"
            }
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "EngineVersion": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The version specified to use. See also EngineVersionCurrent."
    },
    "DeploymentMode": {
      "oneOf": [
        {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "SINGLE_INSTANCE",
                "ACTIVE_STANDBY_MULTI_AZ",
                "CLUSTER_MULTI_AZ"
              ],
              "type": "string"
            },
            {
              "pattern": "^[Ss][Ii][Nn][Gg][Ll][Ee]_[Ii][Nn][Ss][Tt][Aa][Nn][Cc][Ee]$"
            },
            {
              "pattern": "^[Aa][Cc][Tt][Ii][Vv][Ee]_[Ss][Tt][Aa][Nn][Dd][Bb][Yy][__][Mm][Uu][Ll][Tt][Ii]_[Aa][Zz]$"
            },
            {
              "pattern": "^[Cc][Ll][Uu][Ss][Tt][Ee][Rr]_[Mm][Uu][Ll][Tt][Ii][__][Aa][Zz]$"
            }
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "HostInstanceType": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "PubliclyAccessible": {
      "type": "boolean"
    },
    "AuthenticationStrategy": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
