{
  "typeName": "AWS::NetworkFirewall::Firewall",
  "description": "Resource type definition for AWS::NetworkFirewall::Firewall. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-networkfirewall.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-networkfirewall.git",
  "additionalProperties": false,
  "definitions": {
    "ResourceArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:aws.*$",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "A resource ARN.",
      "title": "AWSNetworkFirewallFirewallResourceArnDefinition"
    },
    "EndpointId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "An endpoint Id.",
      "title": "AWSNetworkFirewallFirewallEndpointIdDefinition"
    },
    "AvailabilityZoneMapping": {
      "type": "object",
      "properties": {
        "AvailabilityZone": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A AvailabilityZone"
        }
      },
      "required": [
        "AvailabilityZone"
      ],
      "additionalProperties": false,
      "title": "AWSNetworkFirewallFirewallAvailabilityZoneMappingDefinition"
    },
    "SubnetMapping": {
      "type": "object",
      "properties": {
        "SubnetId": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A SubnetId."
        },
        "IPAddressType": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "A IPAddressType"
        }
      },
      "required": [
        "SubnetId"
      ],
      "additionalProperties": false,
      "title": "AWSNetworkFirewallFirewallSubnetMappingDefinition"
    },
    "EnabledAnalysisType": {
      "oneOf": [
        {
          "enum": [
            "TLS_SNI",
            "HTTP_HOST"
          ],
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "An analysis type.",
      "title": "AWSNetworkFirewallFirewallEnabledAnalysisTypeDefinition"
    },
    "Tag": {
      "type": "object",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "Value",
        "Key"
      ],
      "additionalProperties": false,
      "title": "AWSNetworkFirewallFirewallTagDefinition"
    }
  },
  "properties": {
    "FirewallName": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "FirewallPolicyArn": {
      "$ref": "#/definitions/ResourceArn"
    },
    "VpcId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^vpc-[0-9a-f]+$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "SubnetMappings": {
      "type": "array",
      "insertionOrder": false,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/SubnetMapping"
      }
    },
    "AvailabilityZoneMappings": {
      "type": "array",
      "insertionOrder": false,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/AvailabilityZoneMapping"
      }
    },
    "DeleteProtection": {
      "type": "boolean"
    },
    "SubnetChangeProtection": {
      "type": "boolean"
    },
    "AvailabilityZoneChangeProtection": {
      "type": "boolean"
    },
    "FirewallPolicyChangeProtection": {
      "type": "boolean"
    },
    "TransitGatewayId": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^tgw-[0-9a-z]+$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 512,
          "pattern": "^.*$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ]
    },
    "EnabledAnalysisTypes": {
      "type": "array",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/EnabledAnalysisType"
      },
      "description": "The types of analysis to enable for the firewall. Can be TLS_SNI, HTTP_HOST, or both."
    },
    "Tags": {
      "type": "array",
      "insertionOrder": false,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "network-firewall:TagResource",
      "network-firewall:UntagResource",
      "network-firewall:ListTagsForResource"
    ]
  },
  "required": [
    "FirewallName",
    "FirewallPolicyArn"
  ],
  "readOnlyProperties": [
    "/properties/FirewallArn",
    "/properties/FirewallId",
    "/properties/TransitGatewayAttachmentId",
    "/properties/EndpointIds"
  ],
  "primaryIdentifier": [
    "/properties/FirewallArn"
  ],
  "createOnlyProperties": [
    "/properties/VpcId",
    "/properties/FirewallName"
  ],
  "type": "object",
  "title": "AWSNetworkFirewallFirewallProperties"
}