{
  "typeName": "AWS::Wisdom::MessageTemplateVersion",
  "description": "A version for the specified customer-managed message template within the specified knowledge base.. Source:- https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "properties": {
    "MessageTemplateArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:[a-z-]*?:wisdom:[a-z0-9-]*?:[0-9]{12}:[a-z-]*?/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}(?:/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The unqualified Amazon Resource Name (ARN) of the message template."
    },
    "MessageTemplateContentSha256": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
