{
  "typeName": "AWS::InspectorV2::CisScanConfiguration",
  "description": "CIS Scan Configuration resource schema. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-inspector.git",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-inspector.git",
  "definitions": {
    "CisSecurityLevel": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "LEVEL_1",
            "LEVEL_2"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSInspectorV2CisScanConfigurationCisSecurityLevelDefinition"
    },
    "Schedule": {
      "description": "Choose a Schedule cadence",
      "properties": {
        "OneTime": {
          "$ref": "#/definitions/OneTimeSchedule"
        },
        "Daily": {
          "$ref": "#/definitions/DailySchedule"
        },
        "Weekly": {
          "$ref": "#/definitions/WeeklySchedule"
        },
        "Monthly": {
          "$ref": "#/definitions/MonthlySchedule"
        }
      },
      "title": "AWSInspectorV2CisScanConfigurationScheduleDefinition"
    },
    "OneTimeSchedule": {
      "type": "object",
      "title": "AWSInspectorV2CisScanConfigurationOneTimeScheduleDefinition"
    },
    "DailySchedule": {
      "type": "object",
      "properties": {
        "StartTime": {
          "$ref": "#/definitions/Time"
        }
      },
      "required": [
        "StartTime"
      ],
      "additionalProperties": false,
      "title": "AWSInspectorV2CisScanConfigurationDailyScheduleDefinition"
    },
    "WeeklySchedule": {
      "type": "object",
      "properties": {
        "StartTime": {
          "$ref": "#/definitions/Time"
        },
        "Days": {
          "$ref": "#/definitions/DaysList"
        }
      },
      "required": [
        "StartTime",
        "Days"
      ],
      "additionalProperties": false,
      "title": "AWSInspectorV2CisScanConfigurationWeeklyScheduleDefinition"
    },
    "MonthlySchedule": {
      "type": "object",
      "properties": {
        "StartTime": {
          "$ref": "#/definitions/Time"
        },
        "Day": {
          "$ref": "#/definitions/Day"
        }
      },
      "required": [
        "StartTime",
        "Day"
      ],
      "additionalProperties": false,
      "title": "AWSInspectorV2CisScanConfigurationMonthlyScheduleDefinition"
    },
    "Time": {
      "type": "object",
      "properties": {
        "TimeOfDay": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "TimeZone": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "required": [
        "TimeOfDay",
        "TimeZone"
      ],
      "additionalProperties": false,
      "title": "AWSInspectorV2CisScanConfigurationTimeDefinition"
    },
    "DaysList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "$ref": "#/definitions/Day"
      },
      "uniqueItems": true,
      "title": "AWSInspectorV2CisScanConfigurationDaysListDefinition"
    },
    "Day": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "MON",
            "TUE",
            "WED",
            "THU",
            "FRI",
            "SAT",
            "SUN"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSInspectorV2CisScanConfigurationDayDefinition"
    },
    "CisTargets": {
      "properties": {
        "AccountIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d{12}|ALL_ACCOUNTS|SELF$"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          },
          "uniqueItems": true
        },
        "TargetResourceTags": {
          "$ref": "#/definitions/TargetResourceTags"
        }
      },
      "additionalProperties": false,
      "required": [
        "AccountIds",
        "TargetResourceTags"
      ],
      "title": "AWSInspectorV2CisScanConfigurationCisTargetsDefinition"
    },
    "TargetResourceTags": {
      "patternProperties": {
        "^.+$": {
          "$ref": "#/definitions/TagValueList"
        }
      },
      "maxProperties": 5,
      "additionalProperties": false,
      "title": "AWSInspectorV2CisScanConfigurationTargetResourceTagsDefinition"
    },
    "TagValueList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
          }
        ]
      },
      "uniqueItems": true,
      "title": "AWSInspectorV2CisScanConfigurationTagValueListDefinition"
    },
    "CisTagMap": {
      "type": "object",
      "patternProperties": {
        "^.{2,127}$": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^.{1,255}$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "AWSInspectorV2CisScanConfigurationCisTagMapDefinition"
    }
  },
  "properties": {
    "ScanName": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Name of the scan"
    },
    "SecurityLevel": {
      "$ref": "#/definitions/CisSecurityLevel"
    },
    "Schedule": {
      "$ref": "#/definitions/Schedule"
    },
    "Targets": {
      "$ref": "#/definitions/CisTargets"
    },
    "Tags": {
      "$ref": "#/definitions/CisTagMap"
    }
  },
  "required": [
    "ScanName",
    "SecurityLevel",
    "Schedule",
    "Targets"
  ],
  "additionalProperties": false,
  "readOnlyProperties": [
    "/properties/Arn"
  ],
  "primaryIdentifier": [
    "/properties/Arn"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "inspector2:TagResource",
      "inspector2:UntagResource"
    ]
  },
  "type": "object",
  "title": "AWSInspectorV2CisScanConfigurationProperties"
}