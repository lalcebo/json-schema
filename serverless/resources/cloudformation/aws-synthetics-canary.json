{
  "typeName": "AWS::Synthetics::Canary",
  "description": "Resource Type definition for AWS::Synthetics::Canary. Source:- https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-synthetics",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-synthetics",
  "properties": {
    "Name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-z_\\-]{1,255}$"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Name of the canary."
    },
    "Code": {
      "description": "Provide the canary script source",
      "$ref": "#/definitions/Code"
    },
    "ArtifactS3Location": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(s3|S3)://"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Provide the s3 bucket output location for test results"
    },
    "ArtifactConfig": {
      "description": "Provide artifact configuration",
      "$ref": "#/definitions/ArtifactConfig"
    },
    "Schedule": {
      "description": "Frequency to run your canaries",
      "$ref": "#/definitions/Schedule"
    },
    "ExecutionRoleArn": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Lambda Execution role used to run your canaries"
    },
    "RuntimeVersion": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Runtime version of Synthetics Library"
    },
    "SuccessRetentionPeriod": {
      "description": "Retention period of successful canary runs represented in number of days",
      "type": "integer"
    },
    "FailureRetentionPeriod": {
      "description": "Retention period of failed canary runs represented in number of days",
      "type": "integer"
    },
    "Tags": {
      "type": "array",
      "uniqueItems": false,
      "items": {
        "$ref": "#/definitions/Tag"
      }
    },
    "VPCConfig": {
      "description": "Provide VPC Configuration if enabled.",
      "$ref": "#/definitions/VPCConfig"
    },
    "RunConfig": {
      "description": "Provide canary run configuration",
      "$ref": "#/definitions/RunConfig"
    },
    "StartCanaryAfterCreation": {
      "description": "Runs canary if set to True. Default is False",
      "type": "boolean"
    },
    "VisualReference": {
      "description": "Visual reference configuration for visual testing",
      "$ref": "#/definitions/VisualReference"
    },
    "DeleteLambdaResourcesOnCanaryDeletion": {
      "description": "Deletes associated lambda resources created by Synthetics if set to True. Default is False",
      "type": "boolean"
    },
    "ResourcesToReplicateTags": {
      "type": "array",
      "uniqueItems": true,
      "description": "List of resources which canary tags should be replicated to.",
      "items": {
        "$ref": "#/definitions/ResourceToTag"
      }
    },
    "ProvisionedResourceCleanup": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "AUTOMATIC",
            "OFF"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Setting to control if provisioned resources created by Synthetics are deleted alongside the canary. Default is AUTOMATIC."
    },
    "DryRunAndUpdate": {
      "description": "Setting to control if UpdateCanary will perform a DryRun and validate it is PASSING before performing the Update. Default is FALSE.",
      "type": "boolean"
    },
    "BrowserConfigs": {
      "description": "List of browser configurations for the canary",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/BrowserConfig"
      }
    },
    "VisualReferences": {
      "description": "List of visual references for the canary",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/VisualReference"
      }
    }
  },
  "definitions": {
    "Schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Expression": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "DurationInSeconds": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "RetryConfig": {
          "$ref": "#/definitions/RetryConfig",
          "description": "Provide canary auto retry configuration"
        }
      },
      "required": [
        "Expression"
      ],
      "title": "AWSSyntheticsCanaryScheduleDefinition"
    },
    "Code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "S3Bucket": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "S3Key": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "S3ObjectVersion": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Script": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Handler": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "SourceLocationArn": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "Dependencies": {
          "type": "array",
          "description": "List of Lambda layers to attach to the canary",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/Dependency"
          }
        },
        "BlueprintTypes": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "Handler",
            "S3Bucket",
            "S3Key"
          ]
        },
        {
          "required": [
            "BlueprintTypes",
            "S3Bucket",
            "S3Key"
          ]
        },
        {
          "required": [
            "Handler",
            "Script"
          ]
        },
        {
          "required": [
            "BlueprintTypes",
            "Script"
          ]
        }
      ],
      "title": "AWSSyntheticsCanaryCodeDefinition"
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Type": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "LambdaLayer"
              ]
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Type of dependency"
        },
        "Reference": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "arn:[a-zA-Z0-9-]+:lambda:[a-zA-Z0-9-]+:\\d{12}:layer:[a-zA-Z0-9-_]+:[0-9]+",
              "minLength": 1,
              "maxLength": 140
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "ARN of the Lambda layer"
        }
      },
      "required": [
        "Reference"
      ],
      "title": "AWSSyntheticsCanaryDependencyDefinition"
    },
    "Tag": {
      "description": "A key-value pair to associate with a resource.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The key name of the tag. You can specify a value that is 1 to 127 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -. "
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the tag. You can specify a value that is 1 to 255 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -. "
        }
      },
      "required": [
        "Value",
        "Key"
      ],
      "title": "AWSSyntheticsCanaryTagDefinition"
    },
    "VPCConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "VpcId": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ]
        },
        "SubnetIds": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          }
        },
        "SecurityGroupIds": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ]
          }
        },
        "Ipv6AllowedForDualStack": {
          "description": "Allow outbound IPv6 traffic on VPC canaries that are connected to dual-stack subnets if set to true",
          "type": "boolean"
        }
      },
      "required": [
        "SubnetIds",
        "SecurityGroupIds"
      ],
      "title": "AWSSyntheticsCanaryVPCConfigDefinition"
    },
    "RunConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "TimeoutInSeconds": {
          "description": "Provide maximum canary timeout per run in seconds",
          "type": "integer"
        },
        "MemoryInMB": {
          "description": "Provide maximum memory available for canary in MB",
          "type": "integer"
        },
        "EphemeralStorage": {
          "description": "Provide ephemeralStorage available for canary in MB",
          "type": "integer"
        },
        "ActiveTracing": {
          "description": "Enable active tracing if set to true",
          "type": "boolean"
        },
        "EnvironmentVariables": {
          "type": "object",
          "additionalProperties": false,
          "description": "Environment variable key-value pairs.",
          "patternProperties": {
            "[a-zA-Z][a-zA-Z0-9_]+": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
                }
              ]
            }
          }
        }
      },
      "title": "AWSSyntheticsCanaryRunConfigDefinition"
    },
    "VisualReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "BaseCanaryRunId": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Canary run id to be used as base reference for visual testing"
        },
        "BaseScreenshots": {
          "type": "array",
          "description": "List of screenshots used as base reference for visual testing",
          "items": {
            "$ref": "#/definitions/BaseScreenshot"
          }
        },
        "BrowserType": {
          "$ref": "#/definitions/BrowserType"
        }
      },
      "required": [
        "BaseCanaryRunId"
      ],
      "title": "AWSSyntheticsCanaryVisualReferenceDefinition"
    },
    "BaseScreenshot": {
      "type": "object",
      "properties": {
        "ScreenshotName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Name of the screenshot to be used as base reference for visual testing"
        },
        "IgnoreCoordinates": {
          "type": "array",
          "description": "List of coordinates of rectangles to be ignored during visual testing",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
              }
            ],
            "description": "Coordinates of a rectangle to be ignored during visual testing"
          }
        }
      },
      "required": [
        "ScreenshotName"
      ],
      "title": "AWSSyntheticsCanaryBaseScreenshotDefinition"
    },
    "ArtifactConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "S3Encryption": {
          "$ref": "#/definitions/S3Encryption",
          "description": "Encryption configuration for uploading artifacts to S3"
        }
      },
      "title": "AWSSyntheticsCanaryArtifactConfigDefinition"
    },
    "S3Encryption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "EncryptionMode": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "Encryption mode for encrypting artifacts when uploading to S3. Valid values: SSE_S3 and SSE_KMS."
        },
        "KmsKeyArn": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "KMS key Arn for encrypting artifacts when uploading to S3. You must specify KMS key Arn for SSE_KMS encryption mode only."
        }
      },
      "title": "AWSSyntheticsCanaryS3EncryptionDefinition"
    },
    "ResourceToTag": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "lambda-function"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Specifies which resources canary tags should be replicated to.",
      "title": "AWSSyntheticsCanaryResourceToTagDefinition"
    },
    "RetryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "MaxRetries": {
          "type": "integer",
          "description": "maximum times the canary will be retried upon the scheduled run failure"
        }
      },
      "required": [
        "MaxRetries"
      ],
      "title": "AWSSyntheticsCanaryRetryConfigDefinition"
    },
    "BrowserConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "BrowserType": {
          "$ref": "#/definitions/BrowserType"
        }
      },
      "required": [
        "BrowserType"
      ],
      "title": "AWSSyntheticsCanaryBrowserConfigDefinition"
    },
    "BrowserType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "CHROME",
            "FIREFOX"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "title": "AWSSyntheticsCanaryBrowserTypeDefinition"
    }
  },
  "required": [
    "Name",
    "Code",
    "ArtifactS3Location",
    "ExecutionRoleArn",
    "Schedule",
    "RuntimeVersion"
  ],
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "synthetics:TagResource",
      "synthetics:UntagResource"
    ]
  },
  "additionalProperties": false,
  "createOnlyProperties": [
    "/properties/Name"
  ],
  "primaryIdentifier": [
    "/properties/Name"
  ],
  "readOnlyProperties": [
    "/properties/Id",
    "/properties/State",
    "/properties/Code/SourceLocationArn"
  ],
  "writeOnlyProperties": [
    "/properties/Code/S3Bucket",
    "/properties/Code/S3Key",
    "/properties/Code/S3ObjectVersion",
    "/properties/Code/Script",
    "/properties/DeleteLambdaResourcesOnCanaryDeletion",
    "/properties/StartCanaryAfterCreation",
    "/properties/ResourcesToReplicateTags",
    "/properties/RunConfig/EnvironmentVariables",
    "/properties/VisualReference",
    "/properties/VisualReferences",
    "/properties/DryRunAndUpdate"
  ],
  "deprecatedProperties": [
    "/properties/DeleteLambdaResourcesOnCanaryDeletion",
    "/properties/VisualReference"
  ],
  "type": "object",
  "title": "AWSSyntheticsCanaryProperties"
}