    },
    "MaintenanceWindow": {
      "description": "A specification for a time window to apply software updates.",
      "$ref": "#/definitions/MaintenanceWindow"
    },
    "SoftwareSetUpdateMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "USE_LATEST",
            "USE_DESIRED"
          ]
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
