    "EmailAddress"
  ],
  "readOnlyProperties": [
    "/properties/EmailAddressArn"
  ],
  "createOnlyProperties": [
    "/properties/EmailAddress"
  ],
  "primaryIdentifier": [
    "/properties/EmailAddressArn"
  ],
  "type": "object",
  "title": "AWSConnectEmailAddressProperties"
}