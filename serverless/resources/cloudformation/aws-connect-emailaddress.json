  "definitions": {
    "Tag": {
      "description": "A key-value pair to associate with a resource.",
      "type": "object",
      "properties": {
        "Key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The key name of the tag. You can specify a value that is 1 to 128 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -."
        },
        "Value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The value for the tag. You can specify a value that is 0 to 256 Unicode characters in length and cannot be prefixed with aws:. You can use any of the following characters: the set of Unicode letters, digits, whitespace, _, ., /, =, +, and -."
        }
      },
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false,
      "title": "AWSConnectEmailAddressTagDefinition"
    },
    "AliasConfiguration": {
      "description": "Configuration for an email address alias",
      "type": "object",
      "properties": {
        "EmailAddressArn": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^arn:(aws|aws-us-gov):connect:[a-z]{2}-[a-z]+-[0-9]{1}:[0-9]{1,20}:instance/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/email-address/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "The identifier of the email address alias"
        }
      },
      "required": [
        "EmailAddressArn"
      ],
      "additionalProperties": false,
      "title": "AWSConnectEmailAddressAliasConfigurationDefinition"
    }
  },
  "properties": {
    "InstanceArn": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^arn:(aws|aws-us-gov):connect:[a-z]{2}-[a-z]+-[0-9]{1}:[0-9]{1,20}:instance/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "minLength": 1,
          "maxLength": 250
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The identifier of the Amazon Connect instance."
    },
    "Description": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "(^[\\S].*[\\S]$)|(^[\\S]$)",
          "minLength": 1,
          "maxLength": 250
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "A description for the email address."
    },
    "EmailAddress": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "([^\\s@]+@[^\\s@]+\\.[^\\s@]+)",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "Email address to be created for this instance"
    },
    "DisplayName": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "(^[\\S].*[\\S]$)|(^[\\S]$)",
          "minLength": 0,
          "maxLength": 256
        },
        {
          "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
        }
      ],
      "description": "The display name for the email address."
    },
    "AliasConfigurations": {
      "description": "List of alias configurations for the email address",
      "type": "array",
      "items": {
        "$ref": "#/definitions/AliasConfiguration"
      },
      "maxItems": 1,
      "insertionOrder": false
    },
    "Tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "insertionOrder": false,
      "description": "One or more tags.",
      "items": {
        "$ref": "#/definitions/Tag"
      }
    }
  },
  "tagging": {
    "taggable": true,
    "tagOnCreate": true,
    "tagUpdatable": true,
    "cloudFormationSystemTags": true,
    "tagProperty": "/properties/Tags",
    "permissions": [
      "connect:TagResource",
      "connect:UntagResource"
    ]
