          "description": "<p>The Amazon Resource Name (ARN) of the resource.</p>"
        },
        "Description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            },
            {
              "$ref": "../../components/cf.functions.json#/Aws_CF_FunctionString"
            }
          ],
          "description": "<p>The description of the theme.</p>"
