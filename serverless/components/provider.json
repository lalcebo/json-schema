{
  "id": "https://raw.githubusercontent.com/lalcebo/json-schema/master/serverless/components/provider.json",
  "schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "AWS provider-level configuration for Serverless Framework v4: VPC, logs, deployment bucket, domains, S3 buckets, IAM resource policies, and the top-level `provider` block.",
  "additionalProperties": false,
  "AwsTracing": {
    "properties": {
      "apiGateway": {
        "type": "boolean"
      },
      "lambda": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "AwsLogs": {
    "properties": {
      "frameworkLambda": {
        "type": "boolean"
      },
      "lambda": {
        "$ref": "lambda.json#/AwsLambdaLogs"
      },
      "httpApi": {
        "anyOf": [
          {
            "$ref": "api.gateway.v2.json#/AwsHttpApiLogs"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "restApi": {
        "$ref": "api.gateway.v1.json#/AwsRestApiLogs"
      },
      "websocket": {
        "$ref": "events.json#/AwsWebsocketLogs"
      }
    },
    "type": "object"
  },
  "AwsVpc": {
    "properties": {
      "ipv6AllowedForDualStack": {
        "description": "Allow Lambda functions in a dual-stack VPC to access IPv6 resources (v4).",
        "type": "boolean"
      },
      "securityGroupIds": {
        "items": {
          "anyOf": [
            {
              "$ref": "cf.functions.json#/Aws_CF_Function"
            },
            {
              "type": "string"
            }
          ]
        },
        "type": "array"
      },
      "subnetIds": {
        "items": {
          "anyOf": [
            {
              "$ref": "cf.functions.json#/Aws_CF_Function"
            },
            {
              "type": "string"
            }
          ]
        },
        "type": "array"
      }
    },
    "type": "object",
    "required": ["securityGroupIds", "subnetIds"]
  },
  "AwsResourcePolicy": {
    "properties": {
      "Action": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "additionalProperties": {},
            "type": "object"
          },
          {
            "type": "string"
          }
        ]
      },
      "Condition": {
        "additionalProperties": {},
        "type": "object"
      },
      "Effect": {
        "enum": ["Allow", "Deny"],
        "type": "string"
      },
      "Principal": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "additionalProperties": {},
            "type": "object"
          },
          {
            "type": "string"
          }
        ]
      },
      "Resource": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "additionalProperties": {},
            "type": "object"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "type": "object"
  },
  "AwsDeploymentBucket": {
    "description": "Configure the S3 bucket used by Serverless Framework to deploy code packages to Lambda",
    "properties": {
      "blockPublicAccess": {
        "description": "Prevents public access via ACLs or bucket policies (default: false). Note: the deployment bucket is not public by default. These are additional ACLs.",
        "type": "boolean"
      },
      "maxPreviousDeploymentArtifacts": {
        "description": "On deployment, serverless prunes artifacts older than this limit (default: 5)",
        "type": ["string", "number"]
      },
      "name": {
        "description": "Name of an existing bucket to use (default: created by serverless)",
        "type": "string"
      },
      "serverSideEncryption": {
        "type": "string"
      },
      "sseCustomerAlgorithim": {
        "type": "string"
      },
      "sseCustomerKey": {
        "type": "string"
      },
      "sseCustomerKeyMD5": {
        "type": "string"
      },
      "sseKMSKeyId": {
        "type": "string"
      },
      "tags": {
        "$ref": "common.json#/AwsTags"
      },
      "skipPolicySetup": {
        "description": "Skip the creation of a default bucket policy when the deployment bucket is created (default: false)",
        "type": "boolean"
      },
      "versioning": {
        "description": "Enable bucket versioning (default: false)",
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "AwsProviderS3Buckets": {
    "title": "AwsProviderS3Buckets",
    "description": "Declarative S3 bucket configuration (v4). Each key is a logical bucket name.",
    "type": "object",
    "additionalProperties": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "accelerateConfiguration": { "type": "object", "additionalProperties": true },
        "accessControl": { "type": "string" },
        "analyticsConfigurations": { "type": "array" },
        "bucketEncryption": { "type": "object", "additionalProperties": true },
        "corsConfiguration": { "type": "object", "additionalProperties": true },
        "intelligentTieringConfigurations": { "type": "array" },
        "inventoryConfigurations": { "type": "array" },
        "lifecycleConfiguration": { "type": "object", "additionalProperties": true },
        "loggingConfiguration": { "type": "object", "additionalProperties": true },
        "metricsConfigurations": { "type": "array" },
        "notificationConfiguration": { "type": "object", "additionalProperties": true },
        "objectLockConfiguration": { "type": "object", "additionalProperties": true },
        "objectLockEnabled": { "type": "boolean" },
        "ownershipControls": { "type": "object", "additionalProperties": true },
        "publicAccessBlockConfiguration": { "type": "object", "additionalProperties": true },
        "replicationConfiguration": { "type": "object", "additionalProperties": true },
        "tags": { "$ref": "common.json#/AwsTags" },
        "versioningConfiguration": { "type": "object", "additionalProperties": true },
        "websiteConfiguration": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "AwsProviderDomain": {
    "title": "AwsProviderDomain",
    "description": "Custom domain configuration. Provide a string for the simple case or an object for full options.",
    "oneOf": [
      { "type": "string" },
      {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "basePath": { "type": "string" },
          "apiType": { "type": "string", "enum": ["http", "rest", "websocket"] },
          "endpointType": { "type": "string", "enum": ["edge", "regional", "private", "EDGE", "REGIONAL", "PRIVATE"] },
          "certificateArn": { "type": "string" },
          "certificateName": { "type": "string" },
          "createRoute53Record": { "type": "boolean" },
          "createRoute53IPv6Record": { "type": "boolean" },
          "hostedZoneId": { "type": "string" },
          "hostedZonePrivate": { "type": "boolean" },
          "route53Profile": { "type": "string" },
          "route53Region": { "type": "string" },
          "route53Params": { "type": "object", "additionalProperties": true },
          "splitHorizonDns": { "type": "boolean" },
          "securityPolicy": { "type": "string" },
          "accessMode": { "type": "string", "enum": ["basic", "strict"] },
          "tlsTruststoreUri": { "type": "string" },
          "tlsTruststoreVersion": { "type": "string" },
          "enabled": { "type": "boolean" },
          "allowPathMatching": { "type": "boolean" },
          "preserveExternalPathMappings": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    ]
  },
  "AwsProviderDomains": {
    "type": "array",
    "items": { "$ref": "#/AwsProviderDomain" }
  },
  "AwsProvider": {
    "title": "AwsProvider",
    "description": "Configuration for Serverless AWS ",
    "type": "object",
    "properties": {
      "alb": {
        "$ref": "alb.json#/AwsAlb"
      },
      "ecr": {
        "type": "object",
        "properties": {
          "scanOnPush": {
            "description": "Enabling this will make AWS scan image for CVE(Common Vulnerabilities and Exposures)",
            "type": "boolean"
          },
          "images": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "description": "URI of an existing Docker image in ECR",
                      "type": "string"
                    }
                  },
                  "required": ["uri"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "description": "Path to the Docker context that will be used when building that image locally (default: '.')",
                      "type": "string"
                    },
                    "file": {
                      "type": "string",
                      "description": "Dockerfile that will be used when building the image locally (default: 'Dockerfile')"
                    },
                    "buildArgs": {
                      "type": "object"
                    },
                    "buildOptions": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "cacheFrom": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "platform": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      },
      "apiGateway": {
        "$ref": "api.gateway.v1.json#/AwsApiGateway"
      },
      "apiKeys": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "apiName": {
        "description": "Change this to use a custom name for the API Gateway API",
        "type": "string"
      },
      "cfnRole": {
        "type": "string"
      },
      "deploymentBucket": {
        "$ref": "#/AwsDeploymentBucket"
      },
      "deploymentPrefix": {
        "type": "string"
      },
      "endpointType": {
        "enum": ["EDGE", "PRIVATE", "REGIONAL"],
        "type": "string"
      },
      "environment": {
        "$ref": "lambda.json#/AwsEnvironment"
      },
      "httpApi": {
        "$ref": "api.gateway.v2.json#/AwsHttpApi"
      },
      "iam": {
        "$ref": "iam.json#/AwsIamConfiguration"
      },
      "iamManagedPolicies": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "iamRoleStatements": {
        "items": {
          "$ref": "iam.json#/AwsIamRoleStatement"
        },
        "type": "array"
      },
      "logRetentionInDays": {
        "type": ["string", "number"]
      },
      "logs": {
        "$ref": "#/AwsLogs"
      },
      "memorySize": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "description": "Note: API Gateway has a maximum timeout of 30 seconds",
            "type": "number",
            "minimum": 128,
            "maximum": 10240
          }
        ],
        "type": ["string", "number"]
      },
      "name": {
        "enum": ["aws"],
        "type": "string"
      },
      "notificationArns": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "profile": {
        "type": "string"
      },
      "region": {
        "$ref": "common.json#/AwsRegion"
      },
      "reservedConcurrency": {
        "type": ["string", "number"]
      },
      "resourcePolicy": {
        "items": {
          "$ref": "#/AwsResourcePolicy"
        },
        "type": "array"
      },
      "role": {
        "type": "string"
      },
      "rolePermissionsBoundary": {
        "type": "string"
      },
      "rollbackConfiguration": {
        "$ref": "resources.json#/AwsRollbackConfiguration"
      },
      "runtime": {
        "$ref": "lambda.json#/AwsRuntime"
      },
      "stackName": {
        "type": "string"
      },
      "stackParameters": {
        "items": {
          "$ref": "resources.json#/AwsStackParameters"
        },
        "type": "array"
      },
      "stackPolicy": {
        "items": {
          "$ref": "#/AwsResourcePolicy"
        },
        "type": "array"
      },
      "stackTags": {
        "$ref": "common.json#/AwsTags"
      },
      "stage": {
        "type": "string"
      },
      "tags": {
        "$ref": "common.json#/AwsTags"
      },
      "timeout": {
        "type": ["string", "number"]
      },
      "tracing": {
        "$ref": "#/AwsTracing"
      },
      "usagePlan": {
        "$ref": "api.gateway.v1.json#/AwsUsagePlan"
      },
      "versionFunctions": {
        "description": "Use function versioning (enabled by default)",
        "type": "boolean"
      },
      "architecture": {
        "$ref": "common.json#/AwsSupportedArchitecture"
      },
      "vpc": {
        "$ref": "#/AwsVpc"
      },
      "websocketsApiName": {
        "type": "string"
      },
      "websocketsApiRouteSelectionExpression": {
        "type": "string"
      },
      "websocketsDescription": {
        "type": "string"
      },
      "deploymentMethod": {
        "description": "Method used for CloudFormation deployments: 'changesets' or 'direct' (default: changesets). See https://www.serverless.com/framework/docs/providers/aws/guide/deploying#deployment-method",
        "type": "string",
        "enum": ["direct", "changesets"]
      },
      "disableRollback": {
        "type": "boolean",
        "description": "Disable automatic rollback by CloudFormation on failure. To be used for non-production environments."
      },
      "logDataProtectionPolicy": {
        "$ref": "cloudwatch.json#/LogDataProtectionPolicy"
      },
      "runtimeManagement": {
        "$ref": "lambda.json#/AwsLambdaRuntimeManagement"
      },
      "domain": {
        "$ref": "#/AwsProviderDomain"
      },
      "domains": {
        "$ref": "#/AwsProviderDomains"
      },
      "resolver": {
        "description": "Name of the AWS credentials resolver to use for this provider (v4).",
        "type": "string"
      },
      "enableLegacyDeploymentBucket": {
        "description": "Use the legacy per-stack deployment bucket instead of the v4 shared bucket.",
        "type": "boolean"
      },
      "capacityProviders": {
        "$ref": "lambda.json#/AwsCapacityProviders"
      },
      "s3": {
        "$ref": "#/AwsProviderS3Buckets"
      },
      "kmsKeyArn": {
        "description": "Default KMS key ARN used to encrypt Lambda environment variables.",
        "type": "string"
      }
    },
    "required": ["name"]
  },
  "required": [
    "AwsTracing",
    "AwsLogs",
    "AwsVpc",
    "AwsResourcePolicy",
    "AwsDeploymentBucket",
    "AwsProviderS3Buckets",
    "AwsProviderDomain",
    "AwsProviderDomains",
    "AwsProvider"
  ]
}
