{
  "id": "https://raw.githubusercontent.com/lalcebo/json-schema/master/serverless/components/custom.json",
  "schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "`custom` block (plugin configuration) and Serverless AI block for Serverless Framework v4.",
  "additionalProperties": false,
  "ServerlessCustom": {
    "properties": {
      "pythonRequirements": {
        "$ref": "../plugins/python_requirements.json#/definitions/PythonRequirements"
      },
      "wsgi": {
        "$ref": "../plugins/python_wsgi.json#/definitions/PythonWsgi"
      },
      "prune": {
        "$ref": "../plugins/prune.json#/definitions/Prune"
      },
      "esbuild": {
        "$ref": "../plugins/esbuild.json#/definitions/Esbuild"
      },
      "splitStacks": {
        "$ref": "../plugins/split_stacks.json#/definitions/SplitStacks"
      },
      "webpack": {
        "$ref": "../plugins/webpack.json#/definitions/WebpackConfiguration"
      },
      "ssmPublish": {
        "$ref": "../plugins/ssm_publish.json#/definitions/SsmPublishConfiguration"
      }
    },
    "additionalProperties": true,
    "type": "object"
  },
  "ServerlessAi": {
    "title": "ServerlessAi",
    "description": "Serverless AI block: agents, tools, gateways, memory, browsers and code interpreters. The full sub-schema is not validated here — see the docs for shapes. https://www.serverless.com/framework/docs/providers/aws/guide/serverless.yml",
    "type": "object",
    "properties": {
      "agents": { "type": "object", "additionalProperties": true },
      "tools": { "type": "object", "additionalProperties": true },
      "gateways": { "type": "object", "additionalProperties": true },
      "memory": { "type": "object", "additionalProperties": true },
      "browsers": { "type": "object", "additionalProperties": true },
      "codeInterpreters": { "type": "object", "additionalProperties": true }
    },
    "additionalProperties": true
  },
  "required": [
    "ServerlessCustom",
    "ServerlessAi"
  ]
}
